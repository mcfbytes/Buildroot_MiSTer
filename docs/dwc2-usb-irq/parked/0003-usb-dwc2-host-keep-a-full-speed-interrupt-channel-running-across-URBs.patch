 	return 0;
 }
 
@@ -2666,8 +2692,8 @@ static int dwc2_assign_and_init_hc(struct dwc2_hsotg *hsotg, struct dwc2_qh *qh)
 		chan->desc_list_sz = qh->desc_list_sz;
 	}
 
-	dwc2_hc_init(hsotg, chan);
 	chan->qh = qh;
+	dwc2_hc_init(hsotg, chan);
 
 	return 0;
 }
@@ -3289,6 +3315,9 @@ int dwc2_port_suspend(struct dwc2_hsotg *hsotg, u16 windex)
 		hsotg->op_state = OTG_STATE_A_SUSPEND;
 	}
 
+	if (hsotg->params.power_down != DWC2_POWER_DOWN_PARAM_NONE)
+		dwc2_hcd_int_chain_stop_idle(hsotg);
+
 	switch (hsotg->params.power_down) {
 	case DWC2_POWER_DOWN_PARAM_PARTIAL:
 		ret = dwc2_enter_partial_power_down(hsotg);
@@ -4358,6 +4387,9 @@ static int _dwc2_hcd_suspend(struct usb_hcd *hcd)
 	if (!(dwc2_read_hprt0(hsotg) & HPRT0_CONNSTS))
