# /etc/inittab
#
# Copyright (C) 2001 Erik Andersen <andersen@codepoet.org>
#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run
#
# P2.3: reproduces stock's /etc/inittab (work/imgroot/etc/inittab) with two
# adaptations from stock, both documented in docs/init-parity.md:
#   1. The remount-rw line stays commented out, same as stock -- "/" is
#      read-only at boot (ADR 0011) and only becomes rw via /etc/profile's
#      own remount, on login. Buildroot's OWN skeleton default inittab has
#      this line UNCOMMENTED, which would defeat the whole read-only-root
#      design if left in place -- this file overrides that default.
#   2. The serial console runs util-linux `agetty --nohostname` (stock parity:
#      stock's inittab uses agetty too -- BR2_PACKAGE_UTIL_LINUX_AGETTY is now
#      enabled, see docs/util-linux-parity.md), but targets ttyS0 @ 115200
#      explicitly rather than stock's "console" alias, matching this board's
#      actual cmdline (docs/boot-chain.md: "console=ttyS0,115200"). agetty
#      auto-detects the numeric field as the baud rate, so "ttyS0 115200" and
#      "115200 ttyS0" are equivalent; the port-first form is kept for continuity
#      with the previous BusyBox getty line.
#   3. loadkeys/setfont are RESTORED (T3), but guarded -- history: P2.3 dropped
#      both lines because this BusyBox build has no "loadkeys" applet and
#      CONFIG_SETFONT is not set (still true of busybox; re-verified in
#      output/build/busybox-1.38.0/.config). The real kbd package (which is
#      what provides stock's loadkeys/setfont too -- stock's setfont hardcodes
#      /usr/share/consolefonts, the Buildroot-kbd layout) is being added by a
#      parallel task (T5, BR2_PACKAGE_KBD); /etc/kbd.map itself ships in this
#      overlay either way (T3, stock-identical -- it blanks VC keycodes 88/113/
#      114/115 = F12/Mute/Vol-/Vol+, the keys Main_MiSTer consumes via evdev
#      for OSD and volume, so the framebuffer console stops double-acting on
#      them). The [ -x ] guards make boot correct in BOTH orderings: with kbd
#      present the lines do stock's exact job; without it they are silent
#      no-ops instead of a boot-time error. Real paths (/usr/bin/*), not
#      stock's /bin/* merged-usr aliases -- same reasoning as the gpm note
#      below. Bare "setfont" loads default8x16 (kbd-2.9.0 src/libkfont/
#      setfont.c:417 falls back to findfont("default8x16"); the font ships in
#      kbd's own data/consolefonts), which is why no font argument is given --
#      matching stock's bare-setfont line exactly.
#      gpm is kept (BR2_PACKAGE_GPM=y, binary present).

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
#::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
# / is read-only, so /run (tmpfs) starts empty each boot. /var/lock -> /run/lock
# and /var/run -> /run, but nothing creates /run/lock, so daemons that take a
# lock (sshd, crond, ...) fail their `touch /var/lock/<name>`. Create it here,
# after `mount -a` has mounted the /run tmpfs.
::sysinit:/bin/mkdir -p /run/lock /run/lock/subsys
::sysinit:/media/fat/MiSTer &
::sysinit:/etc/resync &
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS
# Console keymap + font, stock parity (guarded -- see note 3 above)
::sysinit:/bin/sh -c '[ -x /usr/bin/loadkeys ] && /usr/bin/loadkeys /etc/kbd.map'
::sysinit:/bin/sh -c '[ -x /usr/bin/setfont ] && /usr/bin/setfont'
# /usr/sbin, NOT stock's /sbin -- a deliberate, permanent deviation.
# gpm is a real package (not a BusyBox applet, which would land in /sbin
# regardless), and Buildroot builds it with --prefix=/usr, so the binary's
# real path is /usr/sbin/gpm whether or not the rootfs is usr-merged. Stock's
# binary lives there too; stock's inittab just reaches it via the /sbin ->
# usr/sbin compat symlink, which only exists because stock is usr-merged.
# So /usr/sbin/gpm is correct in both layouts and stock's /sbin/gpm is correct
# in only one. That was not academic: this build was NOT usr-merged until
# P2.9 v2, and stock's path would have silently failed to spawn gpm on every
# boot (caught in acceptance, before it ever shipped). We are usr-merged now,
# so /sbin/gpm would resolve -- but the real path is kept anyway so this line
# survives an unmerge. Same history as the /etc/profile PATH note.
::sysinit:/usr/sbin/gpm -m /dev/input/mice -t imps2

# Put a getty on the serial port (util-linux agetty, adapted from stock -- note 2)
ttyS0::respawn:/sbin/agetty --nohostname -L ttyS0 115200 vt100

# Stuff to do for the 3-finger salute
#::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
