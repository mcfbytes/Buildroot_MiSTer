# The device nodes the jailed bluetoothd (uid 8423, no DAC override) opens: uhid
# for BLE HID, rfkill, and the USB pads sixaxis cable-pairs (plugins/sixaxis.h).
KERNEL=="uhid", GROUP="bluetooth", MODE="0660"
KERNEL=="rfkill", GROUP="bluetooth", MODE="0660"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0268|042f|05c4|09cc", GROUP="bluetooth", MODE="0660"
