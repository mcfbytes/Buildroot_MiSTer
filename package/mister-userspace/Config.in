	select BR2_PACKAGE_DBUS_GLIB
	select BR2_PACKAGE_LIBEVENT
	select BR2_PACKAGE_LIBNL
	select BR2_PACKAGE_IPTABLES
	select BR2_PACKAGE_LIBGLIB2
