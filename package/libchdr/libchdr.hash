# Locally computed (GitHub does not publish signed hashes for commit-archive
# tarballs -- standard practice for git/github-sourced Buildroot packages,
# per pkg-download.mk / the Buildroot manual §18.5.2). Verified at pin time
# against:
#   https://github.com/rtissera/libchdr/archive/$(LIBCHDR_VERSION).tar.gz
#
#   sha256sum libchdr-$(LIBCHDR_VERSION).tar.gz
#
# Written with the .mk variable rather than a literal revision on purpose:
# renovate-hash-sync.yml rewrites the sha256 DATA line below and can never
# touch a comment, so a literal here goes stale on the first automatic bump.
# Both of these had (they still named the 04a177ee pin, two bumps back), as
# did the "verified at pin time (2026-07-17)" date this replaces.
sha256  a222b1f1c842f988c2aad51e5f56ba94a423ed87ccab71f1abdb757caa7444f5  libchdr-6cde5348eb118da3baf94f75a69577a005a484fd.tar.gz
# LICENSE.txt -- the BSD-3-Clause text; see the LIBCHDR_LICENSE comment in
# the .mk (the bundled dr_flac's public-domain/MIT-0 statements live inside
# include/dr_libs/dr_flac.h itself, no separate file exists to hash)
sha256  e3989a7aee74a91b8cdbdfe204a6b8d03288863ec7533a21c51f1a987ba73539  LICENSE.txt
