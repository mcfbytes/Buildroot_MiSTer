// SPDX-License-Identifier: GPL-2.0-only
/*
 * Terasic DE25-Nano — Intel/Altera Agilex 5 (A5EB013BB23BE4S)
 *
 * Board device tree for mainline Linux 7.4.x, on top of mainline's
 * socfpga_agilex5.dtsi. Rationale per node: docs/de25-dts-rationale.md.
 *
 * Copyright (C) 2023, Intel Corporation           (upstream socfpga_agilex5)
 * Copyright (C) 2025, Altera Corporation          (DE25-Nano board wiring)
 */

#include "arm64/intel/socfpga_agilex5.dtsi"
#include <dt-bindings/input/input.h>

/ {
	/* altera.yaml's Agilex 5 board list is a closed enum; identity lives in "model". */
	model = "Terasic DE25-Nano";
	compatible = "intel,socfpga-agilex5-socdk", "intel,socfpga-agilex5";

	aliases {
		serial0 = &uart1;
		/* Load-bearing: U-Boot writes $ethaddr into the node this alias names. */
		ethernet0 = &gmac0;
		i2c1 = &i2c1;
	};

	chosen {
		/* No bootargs: U-Boot's fdt_chosen() overwrites them from $bootargs. */
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		/* /sys/class/leds/hps_led0 comes from "label", same ABI as the DE10. */
		led-0 {
			label = "hps_led0";
			gpios = <&portb 17 GPIO_ACTIVE_LOW>;
		};
	};

	/* 1 GiB fallback; U-Boot rewrites this node from the IO96B readout. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	/* No fpga-bridges and no config-complete-timeout-us: docs/de25-fpga-reconfig.md §4. */
	base_fpga_region: fpga-region {
		compatible = "fpga-region";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		fpga-mgr = <&fpga_mgr>;
	};
};

&{/firmware/svc} {
	/* Selects the physical-address SMC path our BL31 serves: docs/de25-vendor-kernel-delta.md §3. */
	compatible = "intel,agilex-svc";

	/* Two strings: the stock driver binds through the second. */
	fpga_mgr: fpga-mgr {
		compatible = "intel,agilex5-soc-fpga-mgr",
			     "intel,agilex-soc-fpga-mgr";
	};
};

/* Off by decision (ADR 0029 D10, ADR 0034); every iommus property is kept and inert. */
&smmu {
	status = "disabled";
};

&soc {
	/* Absent from mainline's dtsi. 7.4's SD6HC driver programs the PHY for every mode itself. */
	mmc0: mmc@10808000 {
		compatible = "altr,agilex5-sd6hc", "cdns,sd6hc";
		reg = <0x10808000 0x1000>;
		interrupts = <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>;
		resets = <&rst SDMMC_RESET>, <&rst COMBOPHY_RESET>, <&rst SDMMC_OCP_RESET>;
		reset-names = "sdhc-reset", "combophy", "sdmmc-ocp";
		clocks = <&clkmgr AGILEX5_SDMCLK>, <&clkmgr AGILEX5_L4_MP_CLK>;
		clock-names = "ciu", "biu";
		iommus = <&smmu 5>;
		/* No dma-coherent until measured with the SMMU off: docs/de25-dts-rationale.md §4.5. */

		bus-width = <4>;
		/* SD high speed at 3.3 V; no UHS without a 1.8 V regulator (docs/de25-dts-rationale.md §2.8). */
		max-frequency = <50000000>;
		cap-sd-highspeed;
		disable-wp;
		no-1-8-v;
		no-sdio;

		/* <caps1 caps>: mask SDR50 tuning and the base clock field, which comes from ciu. */
		sdhci-caps = <0x00000000 0x0000c800>;
		sdhci-caps-mask = <0x00002000 0x0000ff00>;

		status = "okay";
	};
};

&gmac0 {
	status = "okay";
	/* "rgmii", not "rgmii-id": the TX/RX delays are on the PCB. */
	phy-mode = "rgmii";
	phy-handle = <&emac0_phy0>;
	max-frame-size = <9000>;
	/* Same first-boot rule as mmc0: docs/de25-dts-rationale.md §4.5. */
	/delete-property/ dma-coherent;

	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		emac0_phy0: ethernet-phy@1 {
			reg = <1>;
		};
	};
};

&gpio1 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&usb0 {
	status = "okay";
	disable-over-current;
};

/* All five enabled: a watchdog firmware started is only petted if its node is. */
&watchdog0 {
	status = "okay";
};

&watchdog1 {
	status = "okay";
};

&watchdog2 {
	status = "okay";
};

&watchdog3 {
	status = "okay";
};

&watchdog4 {
	status = "okay";
};

/* Root of the peripheral clock tree; mainline declares it at 0 Hz. */
&osc1 {
	clock-frequency = <25000000>;
};

/* MiSTer HPS<->FPGA interface: DE10 names, at the DE10 address + 0x80000000. */
/* docs/dts-mister-fpga-interface.md §7 */
/ {
	/* FPGA-shared LPDDR, kept from the kernel by the DTB as well as by mem=511M. */
	reserved-memory {
		mister_ddr_low: mister-ddr-low@9ff00000 {
			reg = <0x0 0x9ff00000 0x0 0x000ff000>;
			no-map;
		};

		mister_handoff: mister-handoff@9ffff000 {
			reg = <0x0 0x9ffff000 0x0 0x00001000>;
			no-map;
		};

		mister_scaler: mister-scaler@a0000000 {
			reg = <0x0 0xa0000000 0x0 0x01800000>;
			no-map;
		};

		mister_core_lo: mister-core@a1800000 {
			reg = <0x0 0xa1800000 0x0 0x00800000>;
			no-map;
		};

		mister_fb_mem: mister-fb@a2000000 {
			reg = <0x0 0xa2000000 0x0 0x01800000>;
			no-map;
		};

		mister_core_hi: mister-core@a3800000 {
			reg = <0x0 0xa3800000 0x0 0x1c800000>;
			no-map;
		};
	};

	/* Map-only UIO nodes, uio name mister_<name>; MAP_SHARED only. */
	mister {
		compatible = "simple-mfd";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Touch only after fpga0 reports "operating": a read of an unconfigured fabric is an SError. */
		lw-bridge@20000000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_lw_bridge";
			reg = <0x0 0x20000000 0x0 0x00200000>;
		};

		/* First H2F window only (1 GiB); the 15 GiB and 240 GiB windows are not described. */
		h2f-bridge@40000000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_h2f_bridge";
			reg = <0x0 0x40000000 0x0 0x40000000>;
		};

		ddr-aperture@a0000000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_ddr_aperture";
			reg = <0x0 0xa0000000 0x0 0x20000000>;
			mister,map-writecombine;
		};

		ddr-low@9ff00000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_ddr_low";
			reg = <0x0 0x9ff00000 0x0 0x000ff000>,
			      <0x0 0x9ffff000 0x0 0x00001000>;
		};

		/* HPS on-chip RAM below the SPL handoff page; Device memory, so aligned accesses only. */
		ocram@0 {
			compatible = "generic-uio";
			linux,uio-name = "mister_ocram";
			reg = <0x0 0x00000000 0x0 0x0007f000>;
		};

		/* f2h_irq[N] = GIC SPI 17+N [U until a board confirms]; N=0 is kept for a future fb vsync. */
		fabric-irqs {
			compatible = "simple-mfd";
			interrupt-parent = <&intc>;

			f2h-irq1 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq1";
				interrupts = <GIC_SPI 18 IRQ_TYPE_EDGE_RISING>;	/* video_sync, a pulse */
			};

			f2h-irq2 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq2";
				interrupts = <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq3 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq3";
				interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq4 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq4";
				interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq5 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq5";
				interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq6 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq6";
				interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq7 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq7";
				interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq8 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq8";
				interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq9 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq9";
				interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq10 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq10";
				interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq11 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq11";
				interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
