headset: build without snd_card_free_on_error() on Linux 7.4

Linux 7.4 removes snd_card_free_on_error(). On 7.4+ free the devm card on
the init error paths ourselves, which is what the helper did; below 7.4
the helper is still used and behaviour is unchanged.

Upstream-Status: Pending

--- a/driver/headset.c
+++ b/driver/headset.c
@@ -308,7 +308,7 @@
 
 	err = snd_pcm_new(card, GIP_HS_NAME, 0, 1, 1, &pcm);
 	if (err)
-		return err;
+		goto err_free_card;
 
 	strscpy(pcm->name, GIP_HS_NAME, sizeof(pcm->name));
 	pcm->private_data = headset;
@@ -317,7 +317,17 @@
 	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &gip_headset_pcm_ops);
 	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_VMALLOC, NULL, 0, 0);
 
-	return snd_card_register(card);
+	err = snd_card_register(card);
+	if (err)
+		goto err_free_card;
+	return 0;
+
+err_free_card:
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 4, 0)
+	/* 7.4 dropped snd_card_free_on_error(); do what it did */
+	snd_card_free(card);
+#endif
+	return err;
 }
 
 static void gip_headset_config(struct work_struct *work)
@@ -401,7 +411,11 @@
 		return;
 
 	dev_dbg(&client->dev, "%s: init pcm device.\n", __func__);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 4, 0)
+	err = gip_headset_init_pcm(headset);
+#else
 	err = snd_card_free_on_error(&client->dev, gip_headset_init_pcm(headset));
+#endif
 	if (err) {
 		dev_err(&client->dev, "%s: init PCM failed: %d\n",
 			__func__, err);
