diff --git a/drivers/usb/dwc2/hcd_ddma.c b/drivers/usb/dwc2/hcd_ddma.c
index ae34cbf..dbf34c9 100644
--- a/drivers/usb/dwc2/hcd_ddma.c
+++ b/drivers/usb/dwc2/hcd_ddma.c
@@ -13,6 +13,7 @@
 #include <linux/spinlock.h>
 #include <linux/interrupt.h>
 #include <linux/dma-mapping.h>
+#include <linux/delay.h>
 #include <linux/dmapool.h>
 #include <linux/io.h>
 #include <linux/slab.h>
@@ -360,6 +361,9 @@ int dwc2_hcd_qh_init_ddma(struct dwc2_hsotg *hsotg, struct dwc2_qh *qh,
 	if (retval)
 		goto err0;
 
+	/* Only FS/LS INT lists with dma_desc_int_chain are coherent */
+	qh->int_chain = qh->desc_list_coherent;
+
 	if (qh->ep_type == USB_ENDPOINT_XFER_ISOC ||
 	    qh->ep_type == USB_ENDPOINT_XFER_INT) {
 		if (!hsotg->frame_list) {
@@ -847,6 +851,108 @@ static void dwc2_init_non_isoc_dma_desc(struct dwc2_hsotg *hsotg,
 	}
 }
 
+/*
+ * Puts one QTD in the next free slot of a chained INT list. Returns false if
+ * the list is full; a QTD that needs several descriptors also closes it.
+ */
+static bool dwc2_int_chain_add(struct dwc2_qh *qh, struct dwc2_qtd *qtd)
+{
+	struct dwc2_hcd_urb *urb = qtd->urb;
+	struct dwc2_dma_desc *dma_desc;
+	u16 idx = qh->td_last;
+	u32 len, status;
+
+	if (idx >= MAX_DMA_DESC_NUM_GENERIC || !urb)
+		return false;
+
+	len = urb->length - urb->actual_length;
+	if (len > HOST_DMA_NBYTES_LIMIT - (qh->maxp - 1)) {
+		qh->td_last = MAX_DMA_DESC_NUM_GENERIC;
+		return false;
+	}
+
+	/* Always program an integral # of packets for IN transfers */
+	if (qh->ep_is_in && qh->maxp)
+		len = max_t(u32, DIV_ROUND_UP(len, qh->maxp), 1) * qh->maxp;
+
+	status = (len << HOST_DMA_NBYTES_SHIFT & HOST_DMA_NBYTES_MASK) |
+		 HOST_DMA_A | HOST_DMA_IOC;
+	/* The core halts at the end of the ring and the list is re-armed */
+	if (idx == MAX_DMA_DESC_NUM_GENERIC - 1)
+		status |= HOST_DMA_EOL;
+
+	qh->n_bytes[idx] = len;
+	dma_desc = &qh->desc_list[idx];
+	dma_desc->buf = (u32)(urb->dma + urb->actual_length);
+	/* The A bit hands the descriptor over; buf must be visible first */
+	dma_wmb();
+	WRITE_ONCE(dma_desc->status, status);
+
+	qtd->desc_idx = idx;
+	qtd->n_desc = 1;
+	qtd->in_process = 1;
+	qh->td_last = idx + 1;
+
+	return true;
+}
+
+/*
+ * Builds a chained INT list without EOL, one descriptor per QTD, each with
+ * IOC. Returns false if the first QTD does not fit, to build it the old way.
+ */
+static bool dwc2_init_int_chain_desc(struct dwc2_qh *qh)
+{
+	struct dwc2_qtd *qtd;
+	bool closed = false;
+	int n = 0;
+
+	qh->td_last = 0;
+	list_for_each_entry(qtd, &qh->qtd_list, qtd_list_entry) {
+		if (!closed && dwc2_int_chain_add(qh, qtd)) {
+			n++;
+			continue;
+		}
+		closed = true;
+		qtd->in_process = 0;
+	}
+
+	if (!n)
+		return false;
+
+	/* NTD covers the whole ring so that appended descriptors are fetched */
+	qh->channel->ntd = MAX_DMA_DESC_NUM_GENERIC;
+	return true;
+}
+
+/**
+ * dwc2_hcd_append_xfer_ddma() - Appends queued URBs to a running INT list
+ *
+ * @hsotg: The HCD state structure for the DWC OTG controller
+ * @qh:    The QH, with int_chain set
+ *
+ * Only slots at or after td_last are written, and only while the channel is
+ * enabled. Once the core has stopped it, on BNA or with a halt, the pending
+ * BNA or CHHLTD interrupt re-arms the QTDs left in qtd_list.
+ */
+void dwc2_hcd_append_xfer_ddma(struct dwc2_hsotg *hsotg, struct dwc2_qh *qh)
+{
+	struct dwc2_host_chan *chan = qh->channel;
+	struct dwc2_qtd *qtd;
+
+	if (!chan || chan->qh != qh || !chan->xfer_started ||
+	    chan->halt_status != DWC2_HC_XFER_NO_HALT_STATUS ||
+	    chan->halt_pending || qh->td_last >= MAX_DMA_DESC_NUM_GENERIC ||
+	    !(dwc2_readl(hsotg, HCCHAR(chan->hc_num)) & HCCHAR_CHENA))
+		return;
+
+	list_for_each_entry(qtd, &qh->qtd_list, qtd_list_entry) {
+		if (qtd->in_process)
+			continue;
+		if (!dwc2_int_chain_add(qh, qtd))
+			break;
+	}
+}
+
 /**
  * dwc2_hcd_start_xfer_ddma() - Starts a transfer in Descriptor DMA mode
  *
@@ -879,7 +985,11 @@ void dwc2_hcd_start_xfer_ddma(struct dwc2_hsotg *hsotg, struct dwc2_qh *qh)
 		dwc2_hc_start_transfer_ddma(hsotg, chan);
 		break;
 	case USB_ENDPOINT_XFER_INT:
-		dwc2_init_non_isoc_dma_desc(hsotg, qh);
+		if (!qh->int_chain || !dwc2_init_int_chain_desc(qh)) {
+			dwc2_init_non_isoc_dma_desc(hsotg, qh);
+			/* An EOL list takes no appends */
+			qh->td_last = MAX_DMA_DESC_NUM_GENERIC;
+		}
 		dwc2_update_frame_list(hsotg, qh, 1);
 		dwc2_hc_start_transfer_ddma(hsotg, chan);
 		break;
@@ -1309,10 +1419,11 @@ static void dwc2_complete_non_isoc_xfer_ddma(struct dwc2_hsotg *hsotg,
 		 * Resetting the data toggle for bulk and interrupt endpoints
 		 * in case of stall. See handle_hc_stall_intr().
 		 */
-		if (halt_status == DWC2_HC_XFER_STALL)
+		if (halt_status == DWC2_HC_XFER_STALL || qh->toggle_reset)
 			qh->data_toggle = DWC2_HC_PID_DATA0;
 		else
 			dwc2_hcd_save_data_toggle(hsotg, chan, chnum, NULL);
+		qh->toggle_reset = 0;
 	}
 
 	if (halt_status == DWC2_HC_XFER_COMPLETE) {
@@ -1327,6 +1438,131 @@ static void dwc2_complete_non_isoc_xfer_ddma(struct dwc2_hsotg *hsotg,
 	}
 }
 
+/* Gives back the QTDs a running chained INT channel has retired so far */
+static void dwc2_complete_int_chain_ddma(struct dwc2_hsotg *hsotg,
+					 struct dwc2_host_chan *chan,
+					 int chnum)
+{
+	struct dwc2_qh *qh = chan->qh;
+	struct dwc2_qtd *qtd, *qtd_tmp;
+	int xfer_done, idx, n, i;
+
+	list_for_each_entry_safe(qtd, qtd_tmp, &qh->qtd_list, qtd_list_entry) {
+		if (!qtd->in_process)
+			return;
+
+		idx = qtd->desc_idx;
+		n = qtd->n_desc;
+		for (i = 0; i < n; i++) {
+			/* Errors halt the channel and are handled there */
+			if (!dwc2_non_isoc_desc_done(hsotg, qh, idx + i))
+				return;
+		}
+
+		xfer_done = 0;
+		for (i = 0; i < n && !xfer_done; i++) {
+			if (dwc2_process_non_isoc_desc(hsotg, chan, chnum, qtd,
+						       idx + i,
+						       DWC2_HC_XFER_COMPLETE,
+						       &xfer_done))
+				return;
+		}
+		if (!xfer_done)
+			return;
+	}
+}
+
+/*
+ * Re-arms a chained INT channel the core has stopped, from slot 0, with the
+ * QTDs left in qtd_list. Returns false if it is to be released instead.
+ */
+static bool dwc2_int_chain_restart(struct dwc2_hsotg *hsotg,
+				   struct dwc2_host_chan *chan)
+{
+	struct dwc2_qh *qh = chan->qh;
+
+	if (list_empty(&qh->qtd_list) || chan->halt_pending ||
+	    chan->halt_status != DWC2_HC_XFER_NO_HALT_STATUS ||
+	    !hsotg->flags.b.port_connect_status ||
+	    (dwc2_readl(hsotg, HCCHAR(chan->hc_num)) & HCCHAR_CHENA))
+		return false;
+
+	/* Stale slots may still have A set: clear them all first */
+	memset(qh->desc_list, 0,
+	       sizeof(struct dwc2_dma_desc) * dwc2_max_desc_num(qh));
+	if (!dwc2_init_int_chain_desc(qh))
+		return false;
+
+	chan->data_pid_start = qh->data_toggle;
+	/* Raw bits outside the mask are only cleared here and on init */
+	dwc2_writel(hsotg, ~HCINTMSK_RESERVED14_31, HCINT(chan->hc_num));
+	dwc2_hc_start_transfer_ddma(hsotg, chan);
+	return true;
+}
+
+/**
+ * dwc2_hcd_int_chain_settle() - Waits for a chained INT channel stopping on
+ * BNA to settle
+ *
+ * @hsotg: The HCD state structure for the DWC OTG controller
+ * @chan:  The channel
+ *
+ * Return: false if CHENA stays set. With a CHDIS pending, also waits for a
+ * trailing CHHLTD, so that it cannot hit the channel's next owner.
+ */
+bool dwc2_hcd_int_chain_settle(struct dwc2_hsotg *hsotg,
+			       struct dwc2_host_chan *chan)
+{
+	int us;
+
+	for (us = 0; dwc2_readl(hsotg, HCCHAR(chan->hc_num)) & HCCHAR_CHENA;
+	     us++) {
+		if (us >= 10)
+			return false;
+		udelay(1);
+	}
+	for (us = 0; chan->halt_pending && us < 10; us++) {
+		if (dwc2_readl(hsotg, HCINT(chan->hc_num)) & HCINTMSK_CHHLTD)
+			break;
+		udelay(1);
+	}
+	return true;
+}
+
+/**
+ * dwc2_hcd_int_chain_dequeued() - Completes a dequeue halt of a chained INT
