+/* MiSTer HPS<->FPGA interface: docs/dts-mister-fpga-interface.md */
+/ {
+	/* FPGA-shared DDR, kept from the kernel by the DTB, not only mem=511M. */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		mister_ddr_low: mister-ddr-low@1ff00000 {
+			reg = <0x1ff00000 0x000ff000>;
+			no-map;
+		};
+
+		mister_handoff: mister-handoff@1ffff000 {
+			reg = <0x1ffff000 0x00001000>;
+			no-map;
+		};
+
+		mister_scaler: mister-scaler@20000000 {
+			reg = <0x20000000 0x01800000>;
+			no-map;
+		};
+
+		mister_core_lo: mister-core@21800000 {
+			reg = <0x21800000 0x00800000>;
+			no-map;
+		};
+
+		mister_fb_mem: mister-fb@22000000 {
+			reg = <0x22000000 0x01800000>;
+			no-map;
+		};
+
+		mister_core_hi: mister-core@23800000 {
+			reg = <0x23800000 0x1c800000>;
+			no-map;
+		};
+	};
+
+	MiSTer_fb@22000000 {
+		memory-region = <&mister_fb_mem>;
+	};
+
+	/* Map-only UIO windows + f2h IRQ lines; MAP_SHARED only, key on the uio name. */
+	mister {
+		compatible = "simple-mfd";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* H-1: an undecoded offset hangs the SoC; touch only declared offsets. */
+		lw-bridge@ff200000 {
+			compatible = "generic-uio";
+			linux,uio-name = "mister_lw_window";
+			reg = <0xff200000 0x00200000>;
+		};
+
+		/* H-1: no published core decodes any offset of this window. */
+		h2f-bridge@c0000000 {
+			compatible = "generic-uio";
+			linux,uio-name = "mister_h2f_window";
+			reg = <0xc0000000 0x3c000000>;
+		};
+
+		/* Shared with fpgamgr0; GPO +0x10, GPI +0x14. */
+		fpga-mgr@ff706000 {
+			compatible = "generic-uio";
+			linux,uio-name = "mister_fpga_mgr";
+			reg = <0xff706000 0x00001000>;
+		};
+
+		ddr-aperture@20000000 {
+			compatible = "generic-uio";
+			linux,uio-name = "mister_ddr_aperture";
+			reg = <0x20000000 0x20000000>;
+			mister,map-writecombine;
+		};
+
+		ddr-low@1ff00000 {
+			compatible = "generic-uio";
+			linux,uio-name = "mister_ddr_low";
+			reg = <0x1ff00000 0x000ff000>,
+			      <0x1ffff000 0x00001000>;
+		};
+
+		/* f2h_irq[N] = GIC SPI 40+N; N=0 is MiSTer_fb's vsync. */
