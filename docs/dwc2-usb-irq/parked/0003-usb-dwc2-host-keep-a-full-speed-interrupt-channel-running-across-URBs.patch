@@ -2025,12 +2041,22 @@ static int dwc2_hcd_endpoint_reset(struct dwc2_hsotg *hsotg,
 				   struct usb_host_endpoint *ep)
 {
 	struct dwc2_qh *qh = ep->hcpriv;
+	struct dwc2_host_chan *chan;
 
 	if (!qh)
 		return -EINVAL;
 
 	qh->data_toggle = DWC2_HC_PID_DATA0;
 
