#!/bin/sh

trap "" HUP
trap "" TERM
[ ! -d /var/run/proftpd ] && mkdir /var/run/proftpd
[ ! -f /var/log/wtmp ] && touch /var/log/wtmp

# Written by Scripts/password_login.sh; each card switch adds one -D define.
PASSWORD_LOGIN=/media/fat/linux/password_login

start() {
	set --
	mode="root login off"
	if [ -e "$PASSWORD_LOGIN" ]; then
		set -- "$@" -D MISTER_ROOT_PASSWORD_LOGIN
		mode="root password login ON"
	fi
	printf "Starting ProFTPD: "
	if ! /usr/sbin/proftpd "$@"; then
		echo "FAILED"
		exit 1
	else
		echo "done ($mode)"
	fi
}

stop() {
	printf "Stopping ProFTPD: "
	killall proftpd
        echo "done"
}

case "$1" in
    start)
	start
	;;

    stop)
	stop
	;;

    restart)
    	stop
    	start
	;;

    *)
	echo "Usage: /etc/init.d/S50proftpd {start|stop|restart}"
	exit 1
	;;
esac

exit 0
