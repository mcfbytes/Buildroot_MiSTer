# Quartus Prime Pro for the DE25-Nano base image (docs/de25-base-image.md §4). Untested sketch.
# Build context: Altera's Linux installer and the Agilex 5 device file, downloaded by hand
# (both need Altera's EULA), e.g. qinst-pro-linux-25.3.1-*.run and agilex5-25.3.1.*.qdz.
FROM ubuntu:22.04
ARG QUARTUS_VER=25.3.1
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
	ca-certificates libglib2.0-0 libfontconfig1 libx11-6 libxext6 libxrender1 libsm6 \
	libncurses5 libtcmalloc-minimal4 locales python3 unzip xz-utils \
	&& locale-gen en_US.UTF-8 && rm -rf /var/lib/apt/lists/*
COPY qinst-pro-linux-*.run agilex5-*.qdz /tmp/qinst/
RUN chmod +x /tmp/qinst/*.run && /tmp/qinst/qinst-pro-linux-*.run --mode unattended \
	--accept_eula 1 --installdir /opt/altera_pro/${QUARTUS_VER} && rm -rf /tmp/qinst
ENV LANG=en_US.UTF-8 \
	QUARTUS_ROOTDIR=/opt/altera_pro/${QUARTUS_VER}/quartus \
	PATH=/opt/altera_pro/${QUARTUS_VER}/quartus/bin:/opt/altera_pro/${QUARTUS_VER}/qsys/bin:${PATH}
# A licence, if this device needs one, comes in at run time: -e LM_LICENSE_FILE=...
