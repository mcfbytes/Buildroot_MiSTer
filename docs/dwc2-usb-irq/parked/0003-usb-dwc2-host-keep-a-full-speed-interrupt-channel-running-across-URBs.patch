 			 */
 			dwc2_hc_halt(hsotg, qh->channel,
 				     DWC2_HC_XFER_URB_DEQUEUE);
+		chan = qh->channel;
 	}
 
 	/*
@@ -1955,6 +1968,9 @@ static int dwc2_hcd_urb_dequeue(struct dwc2_hsotg *hsotg,
 		}
 	} else {
 		dwc2_hcd_qtd_unlink_and_free(hsotg, urb_qtd, qh);
+		if (chan && qh->int_chain &&
+		    hsotg->flags.b.port_connect_status)
+			dwc2_hcd_int_chain_dequeued(hsotg, chan);
