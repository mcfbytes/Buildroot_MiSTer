#!/bin/sh
#
# S48timezone   First-boot timezone autodetection.
#
# WHY THIS EXISTS.
# /etc/localtime is a symlink to /media/fat/linux/timezone (stock parity -- the
# rootfs is reflashed wholesale on update, so the timezone has to live on the FAT
# data partition to survive; see docs/init-parity.md and the defconfig's tzdata
# block). On a fresh card that file does not exist yet, so glibc falls back to
# UTC and every timestamp -- save states, screenshots, the OSD clock, ntpd's own
# log lines -- is wrong by the local UTC offset until the user goes and finds
# the community `timezone.sh` script. Most never do. This script does that one
# lookup for them, once, and then gets out of the way forever.
#
# STOCK/COMMUNITY PARITY.
# This is deliberately the same mechanism as the "Automatic" mode of
# MiSTer-devel/Scripts_MiSTer's timezone.sh (v1.4): ask ip-api.com for the
# timezone of the box's public IP, then `cp` the matching file out of
# /usr/share/zoneinfo/posix/ onto /media/fat/linux/timezone. Same source, same
# destination, same file format -- so this and a by-hand timezone.sh run are
# interchangeable, and either can overwrite the other's result. No new package:
# curl is already in the image (BR2_PACKAGE_LIBCURL_CURL) and so is the full
# zoneinfo set (BR2_TARGET_TZ_INFO).
#
# NEVER DELAYS BOOT.
# start() does no network work at all: it checks a few files, then either
# returns or backgrounds detect(). With no network connected it does not even
# background it -- there is no default route, so there is nothing to ask and
# nothing is sent. rcS is never held up, on any path.
#
# THE GUESS IS SPENT WHEN IT IS ACTUALLY MADE -- NOT MERELY ATTEMPTED.
# Three gates, the first two on the data partition so they survive a reflash:
#   - /media/fat/linux/timezone exists and is non-empty -> a timezone is already
#     set, by us on an earlier boot, by timezone.sh, or by hand. Never
#     second-guessed, never overwritten.
#   - /media/fat/linux/timezone.autodetect exists -> the guess has been used.
#     Written only when a provider ANSWERED: with a zone we could install, or
#     with something unusable (asking the same broken provider again tomorrow
#     will not help). Being offline is not an answer, so it does not spend it.
#   - No default route -> no network to ask over. Return immediately, quietly.
# So a box that was offline on its first boot still gets its guess later, once
# the user has set up WiFi -- which is the common case, since the card is
# flashed, booted, and only then configured. The dhcpcd hook below is what makes
# "later" mean "the moment an address arrives" rather than "next boot".
#
# HOW IT GETS RE-TRIED.
#   1. Here, at S48, if a default route already exists (a wired box, or a static
#      address from /etc/network/interfaces). Short retry window: DNS or the
#      provider may lag the route by a few seconds.
#   2. usr/lib/dhcpcd/dhcpcd-hooks/90-timezone, which calls `S48timezone start`
#      whenever dhcpcd brings an interface up with an address -- so a lease that
#      lands after S48, or a WiFi network configured three boots from now, is
#      caught the moment it happens. Re-entry is safe: the gates above make it a
#      no-op once the guess is spent, and $LOCKDIR keeps two lookups from
#      overlapping.
#
# Pre-creating the stamp (`touch /media/fat/linux/timezone.autodetect` on the
# card) disables autodetection before it ever runs -- nothing is ever sent.
#
# WHAT IT DOES NOT DO.
# - It cannot retro-fit the timezone into processes that are already running.
#   glibc reads /etc/localtime once, at the first localtime() call, and caches
#   it; Main_MiSTer is started from inittab's sysinit, before rcS, so on the
#   boot where detection lands its clock stays UTC until the next reboot. The
#   zoneinfo is correct from that point on, permanently, for everything.
# - It does not update /etc/timezone (a label file nothing reads; "Etc/UTC",
#   stock parity) -- / is read-only at this point in boot anyway.
#
# PRIVACY / TRUST, stated plainly: this queries a third party, on one boot, which
# necessarily sees the box's public IP. Nothing else is sent, nothing is stored
# remotely, and the request carries no payload -- the public IP the packet
# already has IS the query. (It is retried while the network is still coming up,
# so "one lookup" can be up to TZ_TRIES x 2 requests; every retry is identical.)
# It is opt-out-able before it ever runs (see the stamp file above).
# ip-api.com's free tier is HTTP-only, so that request is in the clear and a
# hostile network could answer it -- the blast radius is a wrong timezone, and
# the answer is validated against the zoneinfo we ship before it is used.
# See ADR 0025.

TZFILE=/media/fat/linux/timezone
TZSTAMP=/media/fat/linux/timezone.autodetect
ZONEDIR=/usr/share/zoneinfo/posix
# Absolute, and the same string the start() guard tests -- an init script runs
# with whatever PATH init handed it, and the guard would otherwise be checking a
# different thing from the one being executed. Same reasoning as the inittab's
# /usr/sbin/gpm note in docs/init-parity.md.
CURL=/usr/bin/curl
# /run is a tmpfs mounted at sysinit, so a lock can never outlive a boot.
LOCKDIR=/run/timezone-autodetect

# Short window on purpose. This only ever runs when a default route already
# exists, so it is covering the seconds between "route" and "DNS and the
# provider are reachable" -- not waiting for a network to show up. That case is
# the dhcpcd hook's job, and it does it better.
TZ_TRIES=6
TZ_INTERVAL=10

# Spend the guess. Called only when a provider actually answered -- that is the
# difference between "we asked and got nothing useful" (done, permanently) and
# "we never got to ask" (try again the moment there is a network). The body is
# self-documenting, because this file turns up in the same directory users keep
# wpa_supplicant.conf and user-startup.sh in.
stamp() {
	{
		echo "MiSTer timezone autodetection has already run."
		echo "It runs once, and never overrides a timezone you set"
		echo "yourself."
		echo ""
		echo "Result: $1"
		echo ""
		echo "For another go: delete this file and timezone, then reboot."
		echo "To choose by hand instead: run the timezone.sh script."
	} > "$TZSTAMP" 2>/dev/null || :
}

# Do we have anywhere to send a packet? /proc/net/route rather than `ip route`:
# no binary dependency, no fork, and an all-zeroes destination is exactly what
# "default route" means. IPv6-only networks are covered by the ::/0 check.
have_route() {
	while read -r _iface dest _rest; do
		[ "$dest" = "00000000" ] && return 0
	done < /proc/net/route
	[ -r /proc/net/ipv6_route ] &&
		grep -q '^00000000000000000000000000000000 00 ' /proc/net/ipv6_route
}

detect() {
	tries="$TZ_TRIES"
	reached=0
	while [ "$tries" -gt 0 ]; do
		# Providers in order, first plausible answer wins. Quoted, not a
		# variable: the first URL contains a '?', which unquoted would be
		# a glob.
		#   ip-api.com -- what timezone.sh uses. /line/?fields=timezone
		#     returns the bare zone name on one line, i.e. exactly what
		#     its `/json/ | jq -rM .timezone` yields, without the jq.
		#   ipapi.co -- HTTPS fallback, for networks that block or
		#     intercept plain HTTP.
		for url in 'http://ip-api.com/line/?fields=timezone' \
			'https://ipapi.co/timezone'; do
			# curl's OWN exit status, which a pipeline would hide
			# behind head's. It is what separates "no network" from
			# "answered with junk", and that decides whether the
			# guess gets spent.
			if ! raw="$("$CURL" -sfL --max-time 8 "$url" 2>/dev/null)"; then
				continue
			fi
			reached=1
			zone="$(printf '%s\n' "$raw" | head -n 1 | tr -d '\r')"

			# $zone came off the network: validate BEFORE it is ever
			# interpolated into a path. Only the characters real zone
			# names use, which also rules out "." and therefore ".."
			# path traversal, plus shell metacharacters; and it has to
			# name a zone file we actually ship (this also rejects an
			# empty answer, and a directory like "America"). Looser
			# than timezone.sh's `grep -qE "^.+[/].+$"` in one way --
			# a slash is not required -- because ip-api does answer
			# with the slashless-but-real "UTC" for some IPs, and
			# taking it at its word beats retrying until we time out.
			case "$zone" in
				''|*[!A-Za-z0-9/_+-]*) continue ;;
			esac
			[ -f "$ZONEDIR/$zone" ] || continue

			# Write via a temp file so an interrupted or short write
			# (full card, card yanked) leaves no half-copied
			# zoneinfo behind to be cached as the real thing.
			if cp "$ZONEDIR/$zone" "$TZFILE.tmp" &&
				mv -f "$TZFILE.tmp" "$TZFILE"; then
				echo "Timezone: detected $zone"
				stamp "$zone"
				return 0
			fi
			# Not an answer problem -- the card is full, read-only or
			# gone. No stamp: a later attempt should still get its go.
			rm -f "$TZFILE.tmp"
			echo "Timezone: cannot write $TZFILE" >&2
			return 1
		done
		tries=$((tries - 1))
		[ "$tries" -gt 0 ] && sleep "$TZ_INTERVAL"
	done

	if [ "$reached" -eq 1 ]; then
		# We got to ask. Asking the same provider the same question on
		# the next boot will not produce a different answer.
		echo "Timezone: no provider returned a zone we ship, staying on UTC" >&2
		echo "Timezone: set it by hand with the timezone.sh script" >&2
		stamp "a provider answered, but with no zone we ship -- staying on UTC"
	else
		# Never reached anyone, so the guess is NOT spent: the route came
		# and went, or DNS never came up. The dhcpcd hook will call us
		# again on the next address, this boot or any later one.
		echo "Timezone: no answer yet, will retry when the network is up" >&2
	fi
	return 1
}

# Release the lock however detect() ends.
detect_unlocked() {
	detect
	rmdir "$LOCKDIR" 2>/dev/null
}

start() {
	# Already set -- by an earlier boot, by timezone.sh, or by hand. Never
	# second-guess that.
	[ -s "$TZFILE" ] && return 0
	# The guess has already been spent (or was pre-empted on purpose).
	[ -e "$TZSTAMP" ] && return 0
	# No data partition (or no linux/ dir on it): nowhere to persist to.
	[ -d /media/fat/linux ] || return 0
	[ -x "$CURL" ] || return 0
	# No network. Nothing is sent, nothing is logged, nothing is spent --
	# dhcpcd's 90-timezone hook calls us back when an address arrives.
	have_route || return 0
	# One lookup at a time: this can be entered twice on the same boot, once
	# from rcS and once from that hook. mkdir is the atomic test-and-set.
	mkdir "$LOCKDIR" 2>/dev/null || return 0

	echo "Timezone: not set, detecting in background"
	detect_unlocked &
}

case "$1" in
	start|restart|reload)
		# Nothing to stop first: detection is a one-shot that either
		# concluded long ago or was never started, and start is a no-op
		# once a gate is in place. So restart/reload just re-run it,
		# which is how you re-trigger a lookup (after deleting both
		# $TZFILE and $TZSTAMP) without a reboot.
		start;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
