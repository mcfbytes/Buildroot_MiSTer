	select BR2_PACKAGE_ETHTOOL
	select BR2_PACKAGE_SOCAT
	select BR2_PACKAGE_TCPDUMP
	select BR2_PACKAGE_IPERF3
	# --- T5: archival — package/7zip (OURS), not upstream p7zip (ADR 0023, §5.37) ---
	select BR2_PACKAGE_7ZIP
	select BR2_PACKAGE_ZIP
	select BR2_PACKAGE_LZOP
	# --- T5: hardware buses (§5.39) ---
	select BR2_PACKAGE_SPI_TOOLS
