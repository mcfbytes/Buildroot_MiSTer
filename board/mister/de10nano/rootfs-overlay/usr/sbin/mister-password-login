#!/bin/bash
# mister-password-login -- turn stock's root password login over SSH and FTP on
# or off. Off by default: SSH takes a key from /media/fat/config/authorized_keys.
#
# Part of MiSTer Linux Modernization.
# https://github.com/mcfbytes/Buildroot_MiSTer
#
# This program is free software: you can redistribute it and/or modify it under
# the terms of the GNU General Public License as published by the Free Software
# Foundation, either version 3 of the License, or (at your option) any later
# version. Distributed WITHOUT ANY WARRANTY; see <https://www.gnu.org/licenses/>.
#
# Scripts/password_login.sh is its launcher; S50sshd and S50proftpd read the flag.
# Design: ADR 0031 (amendment 2026-10-08), docs/ssh-ftp-parity.md §1.4.

set -uo pipefail

readonly FLAG="/media/fat/linux/password_login"
readonly AUTHKEYS="/media/fat/config/authorized_keys"
# The well-known stock hash of "1" that post-build.sh pins.
# shellcheck disable=SC2016 # a literal crypt hash
readonly DEFAULT_HASH='$5$MiSTer618$yiHxlAfaTCausfxfpep3MtaVqiqNTwl/tYeg3FF8rb1'
readonly SERVICES="S50sshd:/var/run/sshd.pid S50proftpd:/var/run/proftpd.pid"
readonly DIALOG="/usr/bin/dialog"
readonly PROMPT_TIMEOUT=120

MODE="menu"

say()  { echo "$*"; }
warn() { echo "$*" >&2; }
die()  { echo "" >&2; echo "ERROR: $*" >&2; exit 1; }
rule() { echo "======================================================================"; }

usage() {
	cat <<'EOF'
mister-password-login -- root password login over SSH and FTP (off by default)

  mister-password-login          explain, show the state, offer a choice
  mister-password-login status   show the state and change nothing
  mister-password-login on       allow root password login (stock behaviour)
  mister-password-login off      key-only SSH, no root FTP login (the default)
EOF
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-h|--help) usage; exit 0 ;;
		status|on|off) MODE="$1" ;;
		*) warn "mister-password-login: unknown argument: $1"; usage >&2; exit 2 ;;
	esac
	shift
done

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
flag_state() { if [ -e "$FLAG" ]; then echo on; else echo off; fi; }

key_count() {
	local n=0 f
	for f in "$AUTHKEYS" /root/.ssh/authorized_keys; do
		[ -f "$f" ] || continue
		n=$((n + $(grep -c '^[[:space:]]*[^#[:space:]]' "$f" 2>/dev/null)))
	done
	echo "$n"
}

password_state() {
	local h
	h="$(awk -F: '$1 == "root" { print $2 }' /etc/shadow 2>/dev/null)"
	if [ -z "$h" ]; then echo unknown
	elif [ "$h" = "$DEFAULT_HASH" ]; then echo default
	else echo changed
	fi
}

state_text() {
	local keys
	keys="$(key_count)"
	if [ "$(flag_state)" = "on" ]; then
		echo "Root password login (SSH and FTP): ON"
	else
		echo "Root password login (SSH and FTP): OFF"
	fi
	if [ "$keys" -gt 0 ]; then
		echo "SSH keys: $keys in $AUTHKEYS"
	else
		echo "SSH keys: none in $AUTHKEYS"
	fi
	case "$(password_state)" in
		default) echo "Root password: the public default \"1\"" ;;
		changed) echo "Root password: changed (an image update resets it to \"1\")" ;;
		*)       echo "Root password: could not be read" ;;
	esac
}

# ---------------------------------------------------------------------------
# Switch
# ---------------------------------------------------------------------------
# Stop, wait for the old listener to let go of its port, start. sshd's open
# sessions are sshd-session processes, so an SSH login survives this.
restart_services() {
	local entry svc pidfile pid tries
	for entry in $SERVICES; do
		svc="/etc/init.d/${entry%%:*}"
		pidfile="${entry#*:}"
		[ -x "$svc" ] || continue
		pid="$(cat "$pidfile" 2>/dev/null)"
		"$svc" stop
		tries=10
		while [ -n "$pid" ] && [ "$tries" -gt 0 ] && kill -0 "$pid" 2>/dev/null; do
			sleep 1
			tries=$((tries - 1))
		done
		"$svc" start || warn "WARNING: $svc did not start; reboot to retry."
	done
}

set_flag() {
	[ "$(id -u)" -eq 0 ] || die "must run as root."
	if [ "$1" = "on" ]; then
		[ -d "${FLAG%/*}" ] || die "${FLAG%/*} is not there; is the data partition mounted?"
		echo "Written by Scripts/password_login.sh. Delete this file to turn root password login off." \
			>"$FLAG" || die "could not write $FLAG"
	else
		rm -f "$FLAG" || die "could not remove $FLAG"
	fi
	sync
	[ "$(flag_state)" = "$1" ] || die "$FLAG did not change."
	restart_services
}

do_on() {
	if [ "$(flag_state)" = "on" ]; then
		say "Root password login is already on."
		return 0
	fi
	set_flag on
	say ""
	say "Root password login is ON for SSH and FTP, now and after every reboot."
	if [ "$(password_state)" = "default" ]; then
		say "The password is the public default \"1\": anyone on your network can log in as root."
	fi
}

do_off() {
	if [ "$(flag_state)" = "off" ]; then
		say "Root password login is already off."
		return 0
	fi
	set_flag off
	say ""
	say "Root password login is OFF. SSH takes a key from $AUTHKEYS."
	if [ "$(key_count)" -eq 0 ]; then
		say "There is no key there, so nobody can log in over SSH until you add one."
	fi
}

# ---------------------------------------------------------------------------
# Text and menu
# ---------------------------------------------------------------------------
explain() {
	cat <<EOF
Stock MiSTer lets anyone on your network log in as root over
SSH and FTP with the password "1". This image does not, unless
you turn it on here.

Off (the default):
  * SSH accepts only a key: put your public key in
    config/authorized_keys on the card.
  * FTP does not accept root.
  * The console and the Scripts menu work as always.

On (stock behaviour):
  * SSH and FTP accept root with the root password.
  * FTP sends that password unencrypted.

Use On only on a network you trust.
EOF
}

do_status() {
	rule
	say " Root password login over SSH and FTP"
	rule
	say ""
	state_text
	say ""
	explain
}

do_menu() {
	local choice rc=0
	local -a items

	# Without a tty and dialog (no fb_terminal, or a pipe) a gamepad cannot answer.
	if [ ! -x "$DIALOG" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
		do_status
		say ""
		say "Nothing changed. Over SSH: mister-password-login on | off"
		return 0
	fi

	"$DIALOG" --clear --title " Password login " --timeout "$PROMPT_TIMEOUT" \
		--cr-wrap --no-collapse --msgbox "$(explain)" 0 0 || rc=$?
	if [ "$rc" -ne 0 ]; then
		clear 2>/dev/null || printf '\033[2J\033[H'
		say "Nothing changed."
		return 0
	fi

	if [ "$(flag_state)" = "on" ]; then
		items=(off "Turn OFF: SSH by key only, no root FTP login")
	else
		items=(on "Turn ON: root password login over SSH and FTP")
	fi

	choice="$("$DIALOG" --clear --title " Password login " --timeout "$PROMPT_TIMEOUT" \
		--cr-wrap --no-collapse --no-tags --cancel-label "Cancel" \
		--menu "$(state_text)" 0 0 0 "${items[@]}" 3>&1 1>&2 2>&3)" || rc=$?
	clear 2>/dev/null || printf '\033[2J\033[H'

	if [ "$rc" -ne 0 ] || [ -z "$choice" ]; then
		say "Nothing changed."
		return 0
	fi
	case "$choice" in
		on)  do_on ;;
		off) do_off ;;
	esac
}

case "$MODE" in
	status) do_status ;;
	on)     do_on ;;
	off)    do_off ;;
	menu)   do_menu ;;
esac
