# Locally computed (GitHub does not publish signed hashes for commit
# tarballs — this is the standard practice for git/github-sourced Buildroot
# packages, per pkg-download.mk / the Buildroot manual §18.5.2).
#
#   sha256sum rtl88x2bu-$(RTL88X2BU_VERSION).tar.gz
#
# Written with the .mk variable rather than a literal revision on purpose:
# renovate-hash-sync.yml rewrites the sha256 DATA line below and can never
# touch a comment, so a literal here goes stale on the first automatic bump.
# This one did (it still named the pre-bump revision) and was caught in
# review of PR #67.
sha256  f8b1631f040bf24f1bed245ea16048f0f1fb3823feae8501f78546d5360c715c  rtl88x2bu-02252b2f5f522030edf27ca9ae9b6cf56abbdef4.tar.gz
sha256  22cdb0a9cf492dbf05c5b27381a5c0e73ae0d4622427b522b0ba92b7495e5fb0  LICENSE
