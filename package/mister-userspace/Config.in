	select BR2_PACKAGE_OPENSSH
	select BR2_PACKAGE_PROFTPD
	select BR2_PACKAGE_WPA_SUPPLICANT
	select BR2_PACKAGE_WPA_SUPPLICANT_NL80211
	select BR2_PACKAGE_WPA_SUPPLICANT_WEXT
