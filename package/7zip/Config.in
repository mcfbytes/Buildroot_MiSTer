config BR2_PACKAGE_7ZIP
	bool "7zip"
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # __sync_*_4 intrinsics
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	help
	  7-Zip, the upstream project by Igor Pavlov, built as the native
	  Linux console application `7zz`, plus `7za` and `7zr` compat
	  symlinks to it (`7zr` is stock MiSTer's only 7-Zip binary name,
	  so scripts written against stock keep working).

	  This REPLACES Buildroot's package/p7zip in this image. p7zip is a
	  third-party Unix port, dead upstream since 16.02 (2016) and
	  continued only by a community fork at 17.06 (2022). 7-Zip has had
	  native Linux support since 21.01, so the port buys nothing.

	  It also builds a STATICALLY linked copy and installs it to
	  $(BINARIES_DIR)/7za, where it is picked up as a payload artifact
	  for the exFAT data partition -- /media/fat/linux/7za, the path the
	  MiSTer Downloader hardcodes and otherwise fetches a 2016 binary
	  from the internet to fill. That is the reason this package exists;
	  see ADR 0023 and docs/downloader-contract.md section 4.

	  Formats: 7z, ZIP, TAR, GZIP, BZIP2, XZ, ZSTD, WIM, ISO, CAB, RPM,
	  DEB, ARJ, CPIO, plus extract-only RAR/RAR5 and a long tail of
	  filesystem/disk images (ext, NTFS, FAT, HFS, APFS, VDI, VHDX,
	  QCOW). Strictly a superset of what p7zip's 7za covered.

	  https://7-zip.org  --  https://github.com/ip7z/7zip

comment "7zip needs a toolchain w/ threads, wchar, C++"
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on !BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR || \
		!BR2_INSTALL_LIBSTDCPP
