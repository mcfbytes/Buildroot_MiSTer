# mister_installer_defconfig -- the throwaway installer OS's rootfs.cpio
# (ADR 0020; standalone, not a fragment stack). Full rationale: docs/buildroot-config.md §9.

# WARNING: NOT BR2_TARGET_ROOTFS_INITRAMFS, NOT the main config with a flag —
# a fourth small cpio in its own O=, never the ~300 MB target rootfs.

# --- Arch/ABI: same silicon as every other build on this board (§8.1, §9) ---
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y

# --- Toolchain: musl, static-only (§8.2, §9) ---
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_18=y
BR2_STATIC_LIBS=y
# Hash-verified downloads: itsalive is the first externally-sourced package
# in this cpio. docs/buildroot-config.md §9 has the why.
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# C++ only because Rust's musl target-arch gate needs libstdc++; nothing here
# links it. docs/buildroot-config.md §9 has the why.
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# --- No init system: /init reformats and calls reboot directly (§8.3, §9) ---
BR2_INIT_NONE=y

# --- Device nodes: dynamic/devtmpfs, Buildroot's default so no line here ---
# WARNING load-bearing: STATIC drops /dev/console (no /init stdio). docs/buildroot-config.md §9.

# --- Target packages, on top of BusyBox: mkfs.exfat + sfdisk/blkid (util-linux
# basic set, trimmed post-build). No e2fsprogs; docs/buildroot-config.md §9.
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# HDMI splash (ADR 0020 §9, issue #185): itsalive up/image via /init.
# docs/buildroot-config.md §9 has the size/toolchain/artwork rationale.
BR2_PACKAGE_ITSALIVE=y

# --- BusyBox: stage 1's config PLUS the installer applets; /init overlay (§9) ---
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_MISTER_PATH)/board/mister/de10nano/installer-busybox.config"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MISTER_PATH)/board/mister/de10nano/installer-overlay"
# Renders the HDMI splash frames + trims util-linux at build time (ADR 0020
# §9); how and why: docs/installer-build.md.
BR2_ROOTFS_POST_BUILD_SCRIPT="../../board/mister/de10nano/installer-post-build.sh"

# --- Output: a cpio, uncompressed (§8.7, §9) ---
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set

# --- Reproducibility (§8.8, §9) ---
BR2_REPRODUCIBLE=y
