config BR2_PACKAGE_ZAPAROO_SCANOUT
	bool "zaparoo-scanout"
	depends on BR2_LINUX_KERNEL
	depends on BR2_arm
	help
	  Zaparoo's zaparoo_scanout kernel module: /dev/zaparoo-scanout
	  hands one owner two write-combined 1080p RGB565 framebuffer
	  slots above the MiSTer_fb aperture, for vblank-latched page
	  flips. Cyclone V (DE10-Nano) only; the module refuses to load
	  on any other machine. Not autoloaded.

	  The module declares MODULE_LICENSE("Proprietary") because its
	  source is GPL-3.0-or-later, so loading it taints the kernel.

	  https://github.com/ZaparooProject/Menu_MiSTer/tree/master/kernel/scanout-slots

comment "zaparoo-scanout needs a Linux kernel to be built"
	depends on BR2_arm
	depends on !BR2_LINUX_KERNEL
