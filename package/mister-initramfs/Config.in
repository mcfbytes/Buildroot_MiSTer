config BR2_PACKAGE_MISTER_INITRAMFS
	bool "mister-initramfs (stage-1 initramfs cpio for the kernel)"
	select BR2_PACKAGE_MISTER_INITRAMFS_BUSYBOX
	select BR2_PACKAGE_MISTER_INITRAMFS_EXFATPROGS
	help
	  The MiSTer stage-1 initramfs (ADR 0002): a static BusyBox, a
	  static fsck.exfat and board/mister/common/initramfs-overlay/init,
	  packed into images/mister-initramfs.cpio. It replaces stock's
	  in-kernel do_mounts.c patch: /init mounts the SD data partition,
	  loop-mounts linux/linux.img off it and switch_roots into it.

	  It is a PACKAGE of the main build (built with the main toolchain,
	  statically linked) rather than a second Buildroot configuration,
	  so one 'make' produces it and the kernel that embeds it. Enable
	  the kernel side with BR2_LINUX_KERNEL_EXT_MISTER_INITRAMFS (Kernel
	  -> Linux Kernel Extensions), which selects this package and points
	  CONFIG_INITRAMFS_SOURCE at the cpio.

	  Nothing from this package is installed into the rootfs.

	  https://github.com/mcfbytes/Buildroot_MiSTer/blob/master/docs/decisions/0002-initramfs.md

config BR2_PACKAGE_MISTER_INITRAMFS_ITSALIVE
	bool "HDMI splash during the boot-time exFAT repair"
	depends on BR2_PACKAGE_MISTER_INITRAMFS
	depends on BR2_arm # DE10-Nano register map
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_ITSALIVE
	help
	  Puts a full-screen "do not power off" picture on HDMI while
	  /init runs the repair Scripts/check_storage.sh scheduled (ADR
	  0026). Without it that boot is a black screen for as long as
	  fsck.exfat takes.

	  Copies package/itsalive's static binary and two gzipped raw
	  frames from board/mister/de10nano/fsck-splash into the cpio.
	  itsalive is then NOT installed into the rootfs: it must never
	  run beside Main_MiSTer.

config BR2_PACKAGE_MISTER_INITRAMFS_INSTALLER
	bool "SD-card first-boot installer (sdcard.img)"
	depends on BR2_PACKAGE_MISTER_INITRAMFS
	depends on BR2_arm # writes the DE10-Nano's uboot.img
	help
	  Puts the first-boot installer (ADR 0020, as merged into stage
	  1 by ADR 0033) into this cpio: the installer script, a static
	  mkfs.exfat and, with the HDMI splash above, the installer's
	  frames, under /usr/libexec/mister-installer and
	  /usr/share/mister-installer.

	  /init runs it ONLY when the card carries the installer flag
	  that scripts/mk-sdcard.sh puts on sdcard.img (MBR entry 3 plus
	  a magic block at LBA 1024), and the installer spends that flag
	  (wipes the block) as its commit point. Every other boot never
	  reaches it.

	  DE10-Nano only: it writes the DE10's uboot.img.

	  https://github.com/mcfbytes/Buildroot_MiSTer/blob/master/docs/installer-init.md
