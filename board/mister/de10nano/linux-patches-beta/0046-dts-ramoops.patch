+	 * docs/rt-beta-kernel.md treats the two as one piece of work.
+	 *
+	 * USERSPACE.  Nothing appears automatically: mount -t pstore pstore
+	 * /sys/fs/pstore, then read dmesg-ramoops-N, console-ramoops-0 and
+	 * pmsg-ramoops-0.  Records persist until deleted (rm), which is what
+	 * frees the slot for the next crash.
+	 *
+	 * BETA-LOCAL, like 0043-0045.  This node needs CONFIG_PSTORE,
+	 * CONFIG_PSTORE_RAM, CONFIG_PSTORE_CONSOLE and CONFIG_PSTORE_PMSG,
+	 * which board/mister/de10nano/linux-rt.fragment supplies for the RT
+	 * kernel only.  The shared linux-patches/ directory has no series file
+	 * and is applied whole to the stock 6.18 build, so a copy there would
+	 * put this node in the stock DTB, where it would reserve 1 MiB of RAM
+	 * that no driver claims.  Keep it here.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@1fe00000 {
+			compatible = "ramoops";
+			reg = <0x1fe00000 0x00100000>;	/* 510..511 MiB */
+			record-size  = <0x00008000>;	/*  32 KiB x 23 */
+			console-size = <0x00040000>;	/* 256 KiB       */
+			pmsg-size    = <0x00008000>;	/*  32 KiB       */
+			ftrace-size  = <0x00000000>;	/* off; see above */
+			max-reason   = <3>;		/* KMSG_DUMP_EMERG */
+		};
