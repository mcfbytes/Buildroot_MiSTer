diff --git a/drivers/usb/dwc2/hcd_intr.c b/drivers/usb/dwc2/hcd_intr.c
index 5bd81d4..97ada27 100644
--- a/drivers/usb/dwc2/hcd_intr.c
+++ b/drivers/usb/dwc2/hcd_intr.c
@@ -124,7 +124,11 @@ static void dwc2_sof_intr(struct dwc2_hsotg *hsotg)
 
 	hsotg->frame_number = dwc2_hcd_get_frame_number(hsotg);
 
-	dwc2_track_missed_sofs(hsotg);
+	/* SOFs held in hard IRQ context are not missed ones */
+	if (READ_ONCE(hsotg->sof_holdoff) && !hsotg->params.dma_desc_enable)
+		hsotg->last_frame_num = hsotg->frame_number;
+	else
