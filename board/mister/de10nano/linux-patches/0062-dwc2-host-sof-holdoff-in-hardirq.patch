@@ -151,6 +155,73 @@ static void dwc2_sof_intr(struct dwc2_hsotg *hsotg)
 		dwc2_hcd_queue_transactions(hsotg, tr_type);
 	else if (!moved)
 		hsotg->hcd_stats.sof_idle++;
+
+	if (hsotg->sof_net_wake) {
+		hsotg->sof_net_wake = false;
+		if (moved || tr_type != DWC2_TRANSACTION_NONE)
+			hsotg->hcd_stats.sof_net_found++;
+	}
+}
+
+/**
+ * dwc2_hcd_hold_sof() - Acknowledge a SOF that has nothing to schedule
+ *
+ * @hsotg: Programming view of the DWC_otg controller
+ *
+ * Hard IRQ context, no lock: clears a lone SOF when hsotg->sof_due has nothing
+ * due. One in DWC2_SOF_HOLDOFF_MAX is let through as a safety net.
+ *
+ * Return: IRQ_HANDLED if the SOF was acknowledged and nothing else is pending,
+ * IRQ_NONE if no interrupt is pending, else IRQ_WAKE_THREAD.
+ */
+irqreturn_t dwc2_hcd_hold_sof(struct dwc2_hsotg *hsotg)
+{
+	struct dwc2_hcd_stats *st = &hsotg->hcd_stats;
+	u32 gintsts, due;
+	u16 frame;
+
+	if (!READ_ONCE(hsotg->sof_holdoff) || hsotg->params.dma_desc_enable ||
+	    !READ_ONCE(hsotg->priv) || READ_ONCE(hsotg->lx_state) != DWC2_L0 ||
+	    hsotg->hibernated)
+		return IRQ_WAKE_THREAD;
+
+	gintsts = dwc2_readl(hsotg, GINTSTS);
+	if (!(gintsts & GINTSTS_CURMODE_HOST))
+		return IRQ_WAKE_THREAD;
+	gintsts &= dwc2_readl(hsotg, GINTMSK);
+	if (!gintsts) {
+		st->irq_none++;
+		return IRQ_NONE;
+	}
+	if (!(gintsts & GINTSTS_SOF))
+		return IRQ_WAKE_THREAD;
+
+	st->sof_hardirq++;
+	due = READ_ONCE(hsotg->sof_due);
+	frame = dwc2_hcd_get_frame_number(hsotg);
+	if (gintsts != GINTSTS_SOF) {
+		st->wake_other++;
+	} else if (due & DWC2_SOF_DUE_KICK) {
+		st->wake_kick++;
+	} else if ((due & DWC2_SOF_DUE_VALID) &&
+		   dwc2_frame_num_le(due & HFNUM_MAX_FRNUM, frame)) {
+		st->wake_due++;
+	} else if (++hsotg->sof_held_run >= DWC2_SOF_HOLDOFF_MAX) {
+		st->sof_net++;
+		hsotg->sof_net_wake = true;
+	} else {
+		/* Reading HFNUM back flushes the W1C and shows a SOF it ate */
+		dwc2_writel(hsotg, GINTSTS_SOF, GINTSTS);
+		if (dwc2_hcd_get_frame_number(hsotg) == frame) {
+			st->sof_held++;
+			return IRQ_HANDLED;
+		}
+		st->sof_race++;
+		hsotg->sof_redo = true;
+	}
+
+	hsotg->sof_held_run = 0;
+	return IRQ_WAKE_THREAD;
 }
 
