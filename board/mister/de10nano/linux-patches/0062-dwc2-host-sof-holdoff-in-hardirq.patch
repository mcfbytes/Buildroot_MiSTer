@@ -2265,6 +2336,12 @@ irqreturn_t dwc2_handle_hcd_intr(struct dwc2_hsotg *hsotg)
 	/* Check if HOST Mode */
 	if (dwc2_is_host_mode(hsotg)) {
 		gintsts = dwc2_read_core_intr(hsotg);
+		if (hsotg->sof_redo) {
+			hsotg->sof_redo = false;
+			gintsts |= GINTSTS_SOF;
+		}
+		if (!(gintsts & GINTSTS_SOF))
+			hsotg->sof_net_wake = false;
 		if (!gintsts) {
 			spin_unlock(&hsotg->lock);
 			return retval;
@@ -2299,6 +2376,7 @@ irqreturn_t dwc2_handle_hcd_intr(struct dwc2_hsotg *hsotg)
 			dwc2_hc_intr(hsotg);
 		if (gintsts & GINTSTS_PTXFEMP)
 			dwc2_perio_tx_fifo_empty_intr(hsotg);
+		dwc2_hcd_publish_due(hsotg);
 
 		if (dbg_gintsts) {
 			dev_vdbg(hsotg->dev,
diff --git a/drivers/usb/dwc2/hcd_queue.c b/drivers/usb/dwc2/hcd_queue.c
index ad5137c..cf873b4 100644
--- a/drivers/usb/dwc2/hcd_queue.c
+++ b/drivers/usb/dwc2/hcd_queue.c
@@ -1427,6 +1427,7 @@ static enum hrtimer_restart dwc2_wait_timer_fn(struct hrtimer *t)
 		tr_type = dwc2_hcd_select_transactions(hsotg);
 		if (tr_type != DWC2_TRANSACTION_NONE)
 			dwc2_hcd_queue_transactions(hsotg, tr_type);
+		dwc2_hcd_publish_due(hsotg);
 	}
 
 	spin_unlock_irqrestore(&hsotg->lock, flags);
@@ -1644,6 +1645,43 @@ void dwc2_hcd_qh_free(struct dwc2_hsotg *hsotg, struct dwc2_qh *qh)
 	kfree(qh);
 }
 
+/**
+ * dwc2_hcd_publish_due() - Publish the work the next SOF has to schedule
+ *
+ * @hsotg: The HCD state structure for the DWC OTG controller
+ *
+ * Kick if a QH waits for a channel or is already due, else the nearest
+ * inactive periodic next_active_frame. Called under hsotg->lock.
+ */
+void dwc2_hcd_publish_due(struct dwc2_hsotg *hsotg)
+{
+	struct dwc2_qh *qh;
+	u16 now, dist, best = 0;
+	u32 due = 0;
+
+	if (!list_empty(&hsotg->non_periodic_sched_inactive) ||
+	    !list_empty(&hsotg->periodic_sched_ready) ||
+	    !list_empty(&hsotg->periodic_sched_assigned)) {
+		due = DWC2_SOF_DUE_KICK;
+	} else if (!list_empty(&hsotg->periodic_sched_inactive)) {
+		now = dwc2_hcd_get_frame_number(hsotg);
+		list_for_each_entry(qh, &hsotg->periodic_sched_inactive,
+				    qh_list_entry) {
+			if (dwc2_frame_num_le(qh->next_active_frame, now)) {
+				due = DWC2_SOF_DUE_KICK;
+				break;
+			}
+			/* From now, not pairwise: a far QH must not hide a near one */
+			dist = (qh->next_active_frame - now) & HFNUM_MAX_FRNUM;
+			if (!due || dist < best) {
+				best = dist;
+				due = DWC2_SOF_DUE_VALID | qh->next_active_frame;
+			}
+		}
+	}
+	WRITE_ONCE(hsotg->sof_due, due);
+}
+
 /**
  * dwc2_hcd_qh_add() - Adds a QH to either the non periodic or periodic
  * schedule if it is not already in the schedule. If the QH is already in
@@ -1683,12 +1721,15 @@ int dwc2_hcd_qh_add(struct dwc2_hsotg *hsotg, struct dwc2_qh *qh)
 			list_add_tail(&qh->qh_list_entry,
 				      &hsotg->non_periodic_sched_inactive);
 		}
+		dwc2_hcd_publish_due(hsotg);
 		return 0;
 	}
 
 	status = dwc2_schedule_periodic(hsotg, qh);
 	if (status)
 		return status;
+	/* Publish before SOF is unmasked, so the first SOF sees the QH */
+	dwc2_hcd_publish_due(hsotg);
 	if (!hsotg->periodic_qh_count &&
 	    !hsotg->params.dma_desc_enable) {
 		intr_mask = dwc2_readl(hsotg, GINTMSK);
@@ -1967,6 +2008,7 @@ void dwc2_hcd_qh_deactivate(struct dwc2_hsotg *hsotg, struct dwc2_qh *qh,
 	else
 		list_move_tail(&qh->qh_list_entry,
 			       &hsotg->periodic_sched_inactive);
+	dwc2_hcd_publish_due(hsotg);
 }
 
