 	bool new_connection;
 	struct dwc2_hcd_stats hcd_stats;
 	struct dwc2_hcd_stats hcd_stats_base;
+	u32 sof_due;
+#define DWC2_SOF_DUE_KICK	BIT(31)
+#define DWC2_SOF_DUE_VALID	BIT(30)
+	u8 sof_held_run;
+#define DWC2_SOF_HOLDOFF_MAX	64
+	bool sof_net_wake;
+	bool sof_redo;
+	bool sof_holdoff;
 
 	u16 last_frame_num;
 
@@ -1393,6 +1425,9 @@ void dwc2_wakeup_from_lpm_l1(struct dwc2_hsotg *hsotg, bool remotewakeup);
 
 /* This function should be called on every hardware interrupt. */
 irqreturn_t dwc2_handle_common_intr(int irq, void *dev);
+irqreturn_t dwc2_handle_intr(int irq, void *dev);
+irqreturn_t dwc2_handle_hardirq(int irq, void *dev);
+irqreturn_t dwc2_handle_thread(int irq, void *dev);
 
 /* The device ID match table */
 extern const struct of_device_id dwc2_of_match_table[];
@@ -1545,6 +1580,7 @@ void dwc2_hcd_connect(struct dwc2_hsotg *hsotg);
 void dwc2_hcd_disconnect(struct dwc2_hsotg *hsotg, bool force);
 void dwc2_hcd_start(struct dwc2_hsotg *hsotg);
 irqreturn_t dwc2_hcd_handle_irq(struct dwc2_hsotg *hsotg);
+irqreturn_t dwc2_hcd_hold_sof(struct dwc2_hsotg *hsotg);
 int dwc2_core_init(struct dwc2_hsotg *hsotg, bool initial_setup);
 int dwc2_port_suspend(struct dwc2_hsotg *hsotg, u16 windex);
 int dwc2_port_resume(struct dwc2_hsotg *hsotg);
@@ -1574,6 +1610,8 @@ static inline void dwc2_hcd_disconnect(struct dwc2_hsotg *hsotg, bool force) {}
 static inline void dwc2_hcd_start(struct dwc2_hsotg *hsotg) {}
 static inline irqreturn_t dwc2_hcd_handle_irq(struct dwc2_hsotg *hsotg)
 { return IRQ_NONE; }
+static inline irqreturn_t dwc2_hcd_hold_sof(struct dwc2_hsotg *hsotg)
+{ return IRQ_WAKE_THREAD; }
 static inline void dwc2_hcd_remove(struct dwc2_hsotg *hsotg) {}
 static inline int dwc2_core_init(struct dwc2_hsotg *hsotg, bool initial_setup)
 { return 0; }
diff --git a/drivers/usb/dwc2/core_intr.c b/drivers/usb/dwc2/core_intr.c
index f9f8f08..5112329 100644
--- a/drivers/usb/dwc2/core_intr.c
+++ b/drivers/usb/dwc2/core_intr.c
@@ -914,3 +914,53 @@ out:
 
 	return retval;
 }
+
+/**
+ * dwc2_handle_intr() - Interrupt handler when the IRQ line is not split
+ *
+ * @irq: IRQ number
+ * @dev: The struct dwc2_hsotg
+ */
+irqreturn_t dwc2_handle_intr(int irq, void *dev)
+{
+	irqreturn_t retval = dwc2_hcd_hold_sof(dev);
+
+	if (retval != IRQ_WAKE_THREAD)
+		return retval;
+
+	return dwc2_handle_common_intr(irq, dev);
+}
+
+/**
+ * dwc2_handle_hardirq() - Primary handler when the IRQ line is threaded
+ *
+ * @irq: IRQ number
+ * @dev: The struct dwc2_hsotg
+ *
+ * Wakes dwc2_handle_thread() unless dwc2_hcd_hold_sof() took the SOF or
+ * found nothing pending. The line is IRQF_ONESHOT, as when force-threaded.
+ */
+irqreturn_t dwc2_handle_hardirq(int irq, void *dev)
+{
+	return dwc2_hcd_hold_sof(dev);
+}
+
+/**
+ * dwc2_handle_thread() - Threaded handler paired with dwc2_handle_hardirq()
+ *
+ * @irq: IRQ number
+ * @dev: The struct dwc2_hsotg
+ *
+ * Bottom halves are disabled as in a forced thread, so URB givebacks raised
+ * here still run at the end of the pass.
+ */
+irqreturn_t dwc2_handle_thread(int irq, void *dev)
+{
+	irqreturn_t retval;
+
+	local_bh_disable();
+	retval = dwc2_handle_common_intr(irq, dev);
+	local_bh_enable();
+
+	return retval;
+}
