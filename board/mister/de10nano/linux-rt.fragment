# linux-rt.fragment — kernel-config delta for the RT / 7.x beta variant.
#
# Layered on board/mister/de10nano/linux.config by Buildroot at kernel-build
# time (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES, set in configs/mister_rt.fragment).
# See docs/rt-beta-kernel.md.
#
# The base linux.config reconciles cleanly to 7.2 and 7.3 via `olddefconfig`
# (verified: every MiSTer-critical symbol survives), so this fragment carries ONLY the
# deltas that make this the RT/beta kernel: PREEMPT_RT itself and
# pstore/ramoops so a board that dies on this kernel can say what it was doing.

# --- PREEMPT_RT: the point of the variant ------------------------------------
# A fully-preemptible real-time kernel. On Linux 7.3, arch/arm selects
# ARCH_SUPPORTS_RT in-tree (arch/arm/Kconfig:46), and EXPERT=y is inherited from
# linux.config, so PREEMPT_RT is directly selectable — there is NO out-of-tree
# RT patch to carry. (RT for 32-bit ARM merged into mainline in Linux 7.1.)
CONFIG_PREEMPT_RT=y

# --- UIO is in the shared linux.config, not here --------------------------
# Both lines carry the HPS<->FPGA device-tree series (0045, 0072) and the
# CONFIG_UIO* + uio_pdrv_genirq.of_id cmdline it needs
# (docs/dts-mister-fpga-interface.md).

# --- pstore/ramoops: a crash record that outlives the crash -------------------
# The device-tree half is board/mister/de10nano/linux-patches-beta/
# 0046-dts-ramoops.patch — a /reserved-memory node at 0x1FE00000+0x100000 (the
# last MiB below the mem=511M cap), split 23×32 KiB dmesg records / 256 KiB
# console / 32 KiB pmsg. Its header carries the address and split arithmetic.
#
# Motivation, in one line: hardware finding H-1 hung the board three times with
# a serial console attached and produced ZERO bytes of output each time. The
# UART is not a crash channel — it stops being serviced at the instant of the
# hang. DRAM is, and it is still readable on the next boot.
#
# Each symbol below is load-bearing; none is decoration.
#
#   CONFIG_PSTORE          the subsystem itself (fs/pstore/Kconfig: tristate,
#                          default n, so it must be asked for). =y and not =m:
#                          the console frontend has to be registered before the
#                          failures worth recording, which are as likely during
#                          boot as after it, and a module loaded from the rootfs
#                          is far too late.
#   CONFIG_PSTORE_RAM      the ramoops backend — the only one that can work
#                          here. pstore/blk would write crash data to the SD
#                          card through the block layer, which a wedged CPU
#                          cannot drive; ramoops needs nothing but DRAM that
#                          keeps its contents. `depends on CONFIG_PSTORE` and
#                          pulls CONFIG_REED_SOLOMON* in by `select`, so those
#                          are not listed. =y for the same reason as above.
#   CONFIG_PSTORE_CONSOLE  the console frontend, and the one that actually
#                          addresses H-1. Without it the node's console-size is
#                          inert and pstore only records kmsg DUMPS — which a
#                          silent hang never triggers, because the kernel never
#                          reaches its die path. This is what captures printk
#                          output as it is produced, including the tail still
#                          sitting in the UART FIFO.
#   CONFIG_PSTORE_PMSG     /dev/pmsg0, the userspace breadcrumb channel. This is
#                          how a probe tool writes "about to touch LW +0x14"
#                          somewhere that survives the hang it is about to cause
#                          — the single fact all three H-1 investigations had to
#                          recover by bisection. `select CONFIG_RT_MUTEXES`,
#                          already y under PREEMPT_RT.
#
# Symbol names are spelled CONFIG_* throughout, including the ones that are
# NOT set here, so that grepping the canonical name finds the decision.
#
# NOT listed, deliberately: CONFIG_PSTORE_COMPRESS is `default y` and is
# inherited as such (it deflates dmesg records with the zlib library rather than
# the crypto API, specifically to avoid secondary faults while recording a
# panic); CONFIG_REED_SOLOMON* arrive via CONFIG_PSTORE_RAM's `select`;
# CONFIG_PSTORE_FTRACE stays unset even though it would resolve —
# CONFIG_FUNCTION_TRACER=y and CONFIG_DEBUG_FS=y are already in the shared
# linux.config, and CONFIG_PSTORE_FTRACE only `depends on` them, it selects
# nothing — because a fourth ramoops zone would shrink the three that serve
# H-1, for a per-function-call tracing job unrelated to it. The DT node's
# ftrace-size 0 keeps the two halves in lockstep.
#
# BETA-ONLY, and it has to be. The DTS node lives only in
# linux-patches-beta/, so the stock 6.18 DTB has no ramoops node at all;
# setting these symbols in the shared linux.config would give the stock kernel
# a pstore subsystem with nothing to bind to.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# NOTE: the RTL8814AU chip's in-kernel driver (CONFIG_RTW88_8814AU) is
# deliberately NOT set here — the main build migrated that chip to the in-kernel
# rtw88_8814au driver in the shared linux.config, so the beta inherits it
# automatically. Nothing to duplicate.

# NOTE: the HPS watchdog needs NOTHING here, and that was checked rather than
# assumed — see docs/rt-beta-kernel.md §9. The `snps,dw-wdt` nodes are upstream
# in socfpga.dtsi, socfpga_cyclone5.dtsi already does `&watchdog0 { status =
# "okay"; }`, and the shared linux.config already carries CONFIG_WATCHDOG=y and
# CONFIG_DW_WATCHDOG=y. /dev/watchdog0 therefore exists on BOTH kernels today.
# There is no patch to write and no symbol to add: a watchdog whose chardev is
# never opened is a driver that has bound and done nothing, which is exactly
# the safe default wanted. Do not "enable" it here — enabling is a userspace
# decision (open the device and feed it), and adding symbols would only create
# the appearance of a beta-only capability that is not beta-only.

# --- Troubleshooting channels (RT/7.x variant ONLY; the 6.18 stock-parity kernel
# is untouched). Leave with the other debug options when a shipping 7.x kernel
# is cut.
#   CONFIG_NETCONSOLE         send printk (incl. an oops/panic) over UDP to a
#                             listener AS IT HAPPENS -- the LIVE, off-board
#                             channel. It complements, not replaces, the
#                             on-board post-mortem channel: pstore/ramoops IS
#                             provisioned on this kernel (0046-dts-ramoops.patch
#                             reserves 1 MiB at 0x1FE00000; PSTORE_RAM=y above),
#                             but ramoops only helps if the board comes back
#                             from a warm reboot so /sys/fs/pstore can be read,
#                             and it dies with a power cycle or a hang that
#                             never reboots. With the serial console disabled,
#                             netconsole is the one channel that gets the last
#                             lines OFF the board while it is still dying.
#   CONFIG_NETCONSOLE_DYNAMIC configure the target at RUNTIME through configfs
#                             (/sys/kernel/config/netconsole) from the rig's own
#                             out-of-band config -- no listener address is ever
#                             baked into this tree.
#   (inherited, NOT set here) CONFIGFS_FS=y and MAGIC_SYSRQ=y already come from
#                             the shared linux.config, so /sys/kernel/config
#                             exists for the dynamic target and sysrq over
#                             /proc/sysrq-trigger gives a live backtrace/state
#                             dump when the board is wedged but reachable.
#                             MAGIC_SYSRQ_DEFAULT_ENABLE stays at the kernel
#                             default 0x1 (= ALL functions), the same as the
#                             stock-parity 6.18 kernel -- narrowing it here
#                             would make RT diverge from stock for no gain.
# Measured need: a whole-board reboot during a PSX session on 2026-09-02 left no
# trace anywhere (kernel.panic=15 fired; logs on tmpfs died with it).
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y


# --- rtw89 USB drivers new in 7.x (not in 6.18; firmware already ships) -------
# RTL8852AU (Wi-Fi 6), RTL8852CU (Wi-Fi 6E; 6.18 uses out-of-tree rtl8852cu-morrownr), RTL8922AU (Wi-Fi 7).
CONFIG_RTW89_8852AU=m
CONFIG_RTW89_8852CU=m
CONFIG_RTW89_8922AU=m

# --- Cache-aware load balancing (new in 7.x): dormant on a single-LLC SoC -----
# Both A9s share one PL310 L2, so it never activates; drop its per-mm cost (docs/rt-beta-kernel.md §11).
# CONFIG_SCHED_CACHE is not set
