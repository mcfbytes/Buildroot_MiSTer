# Fixed ids for jailed daemons (docs/minijail.md). S92transmission runs its
# daemon as 8422 (pinning package/transmission's user), /usr/bin/bluetoothd as 8423.
transmission 8422 transmission 8422 * /var/lib/transmission - transmission Transmission Daemon
bluetooth 8423 bluetooth 8423 * - - - BlueZ Daemon
