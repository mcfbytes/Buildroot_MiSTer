# re-derived here independently rather than copied:
#
#   sha256sum dl/lzma-sdk/7z2602-src.tar.xz
#   cf967c98bca02a4b8b16375f441825a8e141362f14be1969bbec8e1ca0bff9dd
#
# If the two files ever disagree, one of the two packages has been bumped
# without the other -- see the "SAME UPSTREAM TARBALL" comment in 7zip.mk.
# Verified against:
#   https://github.com/ip7z/7zip/releases/download/26.02/7z2602-src.tar.xz
