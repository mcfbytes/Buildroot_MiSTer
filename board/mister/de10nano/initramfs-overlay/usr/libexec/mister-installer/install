#!/bin/sh
# MiSTer first-boot SD-card installer, exec'd by stage-1 /init as PID 1 on an armed flag.
# THIS FILE CAN BRICK THE BOARD: read docs/installer-init.md and ADR 0033 first.
set -u

# --- Tunables ---------------------------------------------------------------
PAYLOAD_DIR="mister-payload"           # subdir on the shipped p1 holding the real card
PAYLOAD_PART_DIR="mister-payload.part" # the SAME tree while still being written;
                                       # renamed to PAYLOAD_DIR once complete
CORES_DIR="_Console"                   # payload top-level dir skipped first under RAM pressure
DATA_LABEL="MiSTer_Data"               # exFAT volume label the final card must carry
RESERVED_SECTORS=8192                  # 512-byte sectors for the 0xA2 p2: EXACTLY 4 MiB,
                                       # matching genimage-sdcard.cfg's `size = 4M`
P1_START_SECTORS=2048                  # 1 MiB-aligned p1 start LBA, as genimage-sdcard.cfg
MBR_MAX_SECTORS=4294967295             # an MBR entry holds a 32-bit LBA and length
RAM_RESERVE_KB=98304                   # 96 MiB of RAM kept free for the kernel + our own
                                       # working set; the payload tmpfs may use the rest.
DEV_WAIT=30                            # seconds to wait for a block device to enumerate

# --- the installer flag (docs/installer-init.md#the-flag) --------------------
# FLAG_* and partdev() come from FLAG_CONF, sourced once rescue() exists.
FLAG_CONF="/usr/lib/mister/install-flag.conf"
INSTALL_FLAG="/usr/lib/mister/install-flag"
MKFS_EXFAT="/usr/libexec/mister-installer/mkfs.exfat"
# Written right after mkfs: the only exFAT this installer will ever format a second time.
INSTALL_TOKEN="linux/.mister-install-in-progress"
# The user's pre-seed files, kept on the card so a "finish" or "resume" boot still has them.
PRESEED_DIR="linux/.mister-preseed"

# --- where the RAM copy lives ----------------------------------------------
# Separate dirs, so the payload glob can never pick up the two boot files.
RAM_DIR="/tmp/stage"
RAM_PAYLOAD="$RAM_DIR/payload"
RAM_BOOT="$RAM_DIR/boot"

# --- rescue-banner state (all pre-initialised so `set -u` is safe in rescue) --
cmdline=""; DATA_PART="${1:-}"; DISK=""; P1=""; P2=""; P3=""
fat_type=""; stage="starting up"; cores_skipped="no"; card_state=""

# TEST-ONLY interruption knob; see stop_after().
stop_after_stage=""

# First-boot splash (HDMI, console UI, hps_led0): docs/installer-init.md#first-boot-splash.
# >>> SPLASH SECTION BEGIN -- scripts/test-installer-splash.sh extracts everything
# between the markers VERBATIM and sources it alone: keep it self-contained.
SPLASH_TOTAL=10               # user-visible steps; keep in sync with splash_step calls
SPLASH_BAR_CELLS=28           # bar width -- the whole status line must fit 80 cols
SPLASH_FLAG=/run/splash.run   # non-empty => the heartbeat child should keep running

# Pre-initialised so `set -u` is safe if rescue() fires before splash_init;
# splash_tty=0 keeps every drawing routine a no-op until then.
splash_n=0; splash_label="starting up"; splash_bar=""; splash_pct=0
splash_frame=0; splash_t0=0; splash_tty=0
splash_led=""; splash_led_on=0; splash_pulsing=0

# Whole seconds since boot. /proc/uptime is "1234.56 5678.90"; `read` splits it.
splash_uptime() {
	_up=0
	read -r _up _rest < /proc/uptime 2>/dev/null || _up=0
	_up="${_up%%.*}"
	case "$_up" in ''|*[!0-9]*) _up=0 ;; esac
	printf '%s' "$_up"
}

# Elapsed since splash_init, as "0m42s".
splash_elapsed() {
	_e=$(( $(splash_uptime) - splash_t0 ))
	[ "$_e" -ge 0 ] || _e=0
	printf '%dm%02ds' "$((_e / 60))" "$((_e % 60))"
}

# Take the HPS LED off its DTS trigger. hps_led* only: the other /sys/class/leds
# entries belong to USB gamepads.
splash_led_init() {
	splash_led=""
	for _c in /sys/class/leds/hps_led0 /sys/class/leds/hps_led*; do
		[ -w "$_c/brightness" ] || continue
		splash_led="$_c"
		break
	done
	[ -n "$splash_led" ] || return 0
	printf 'none' > "$splash_led/trigger" 2>/dev/null || true
	splash_led_set 0
}

splash_led_set() {
	[ -n "$splash_led" ] || return 0
	printf '%s' "$1" > "$splash_led/brightness" 2>/dev/null || true
	splash_led_on="$1"
}

splash_led_toggle() {
	if [ "$splash_led_on" = 1 ]; then splash_led_set 0; else splash_led_set 1; fi
}

# Pre-render the bar for the current step; the per-second frames only redraw the
# spinner and the clock, so this runs once per step, not once per frame.
splash_render_bar() {
	_i=0; splash_bar=""
	while [ "$_i" -lt "$SPLASH_BAR_CELLS" ]; do
		if [ "$_i" -lt "$1" ]; then splash_bar="$splash_bar#"; else splash_bar="$splash_bar."; fi
		_i=$((_i + 1))
	done
}

# Always `printf '%s' <char>`: '-' would be eaten as an option and '\' escaped.
# "\\" rather than '\' only to keep SC1003 quiet.
splash_spin_char() {
	case $((splash_frame % 4)) in
	0) printf '%s' '|'  ;;
	1) printf '%s' '/'  ;;
	2) printf '%s' '-'  ;;
	*) printf '%s' "\\" ;;
	esac
}

# The live, in-place status line. No trailing newline: it is rewritten with \r
# every frame and erased to end-of-line so a shorter label cannot leave debris.
splash_line() {
	[ "$splash_tty" = 1 ] || return 0
	printf '\r  [%s] %3d%%  %d/%d  %s  %s %s\033[K' \
		"$splash_bar" "$splash_pct" "$splash_n" "$SPLASH_TOTAL" \
		"$(splash_elapsed)" "$(splash_spin_char)" "$splash_label"
}

splash_clear_line() {
	[ "$splash_tty" = 1 ] || return 0
	printf '\r\033[K'
}

splash_banner() {
	printf '%s\n' \
'' \
'================================================================' \
'        .------.' \
'       /  ____ |        M i S T e r' \
'      |  |____||        F I R S T - B O O T   S E T U P' \
'      |        |' \
'      |________|        preparing your SD card' \
'================================================================' \
'  This usually takes well under a minute.' \
'' \
'  *** Do NOT power off or remove the card while the board LED' \
'      is blinking. ***' \
'================================================================' \
''
}

splash_init() {
	splash_t0="$(splash_uptime)"
	if [ -t 1 ]; then splash_tty=1; else splash_tty=0; fi
	splash_led_init
	splash_banner
	splash_step 0 "starting up"
}

# splash_step N "label" -- stops the heartbeat first. On a non-tty it prints one
# plain line per step, so captured logs stay readable.
splash_step() {
	splash_pulse_stop
	splash_n="$1"
	splash_label="$2"
	splash_pct=$(( splash_n * 100 / SPLASH_TOTAL ))
	splash_render_bar "$(( splash_n * SPLASH_BAR_CELLS / SPLASH_TOTAL ))"
	if [ "$splash_tty" = 1 ]; then
		splash_line
	else
		printf '[installer] step %d/%d: %s\n' "$splash_n" "$SPLASH_TOTAL" "$splash_label"
	fi
}

# One animation frame: inline from the polling loops that already sleep 1, and
# from the heartbeat child around the long blocking commands.
splash_tick() {
	splash_frame=$((splash_frame + 1))
	splash_led_toggle
	splash_line
}

splash_heartbeat() {
	while [ -s "$SPLASH_FLAG" ]; do
		splash_tick
		sleep 1
	done
}

splash_pulse_start() {
	[ "$splash_pulsing" = 0 ] || return 0
	printf 'run' > "$SPLASH_FLAG" 2>/dev/null || return 0
	splash_pulsing=1
	splash_heartbeat &
}

# `wait` only once the truncation is OBSERVED to have worked: a bare wait on a
# child that never exits would hang PID 1 forever.
splash_pulse_stop() {
	[ "$splash_pulsing" = 1 ] || return 0
	splash_pulsing=0
	if : > "$SPLASH_FLAG" 2>/dev/null && [ ! -s "$SPLASH_FLAG" ]; then
		wait
	fi
	# The child's toggles were in a subshell. Park the LED OFF, never on: solid on
	# means "stopped, wants a human" (docs/installer-init.md#led).
	splash_led_set 0
}

splash_done() {
	splash_pulse_stop
	splash_n="$SPLASH_TOTAL"; splash_pct=100; splash_label="done"
	splash_render_bar "$SPLASH_BAR_CELLS"
	splash_clear_line
	printf '%s\n' \
'' \
'================================================================' \
'  INSTALL COMPLETE' \
'================================================================'
	printf '  [%s] 100%%   finished in %s\n' "$splash_bar" "$(splash_elapsed)"
	printf '%s\n' \
'' \
'  Rebooting into MiSTer now. The LED goes dark until the menu' \
'  core comes up.' \
'================================================================' \
''
	splash_led_set 0
	splash_hdmi_say --clear 'MiSTer first-time setup: DONE' '' 'Rebooting into MiSTer now.'
}

# Terminal states: LED solid on, and the screen says what happened -- the
# "installing" picture must never outlive the install.
splash_fail() {
	splash_pulse_stop; splash_clear_line; splash_led_set 1
	splash_hdmi_say --clear \
		'MiSTer first-time setup: FAILED' \
		'' \
		'Nothing was installed. The board itself is fine.' \
		'Re-flash sdcard.img to this card and try again.' \
		'Details are on the serial console.'
}
# --- HDMI splash via itsalive (docs/installer-init.md#hdmi-splash) ---
# Every path logs and returns 0; the binary is probed, every call is under timeout.
SPLASH_HDMI_BIN=/usr/bin/itsalive
SPLASH_HDMI_IMAGE_DIR=/usr/share/mister-installer   # splash-<WxH>.raw.gz, gzipped raw BGRX8888
SPLASH_HDMI_CURSOR=/sys/class/graphics/fbcon/cursor_blink
SPLASH_HDMI_OUT=/run/splash-hdmi.out  # the tool's own stderr, replayed as log lines
SPLASH_HDMI_TIMEOUT=15                # seconds per call: the belt over itsalive's
                                      # own mailbox bound (exit 11)
splash_hdmi=0                         # 1 once `itsalive up` has succeeded this boot
splash_hdmi_mode=720p                 # 720p (default) or 480p; see the cmdline parse

# Replay the tool's stderr diagnostics as installer log lines, in order and
# without tearing the status line.
splash_hdmi_log() { splash_clear_line; printf '[installer] hdmi: %s\n' "$*"; splash_line; }
splash_hdmi_replay() {
	[ -s "$SPLASH_HDMI_OUT" ] || return 0
	while read -r _l; do splash_hdmi_log "$_l"; done < "$SPLASH_HDMI_OUT"
}

# splash_hdmi_run ARGS... -- the ONLY way this file invokes itsalive. 127 when
# the binary is absent, otherwise the tool's exit status (or timeout's).
splash_hdmi_run() {
	[ -x "$SPLASH_HDMI_BIN" ] || return 127
	timeout "$SPLASH_HDMI_TIMEOUT" "$SPLASH_HDMI_BIN" "$@"
}

# The image file for the mode: the artwork is pre-rendered per mode because the
# tool blits raw pixels and neither scales nor decodes (ADR 0020 section 9).
splash_hdmi_image() {
	case "$splash_hdmi_mode" in
	480p) printf '%s/splash-640x480.raw.gz'  "$SPLASH_HDMI_IMAGE_DIR" ;;
	*)    printf '%s/splash-1280x720.raw.gz' "$SPLASH_HDMI_IMAGE_DIR" ;;
	esac
}

# splash_hdmi_say [--clear] LINE... -- one `itsalive say` per LINE; a no-op until
# `up` has succeeded. --clear erases the picture (terminal states only).
splash_hdmi_say() {
	[ "$splash_hdmi" = 1 ] || return 0
	_clear=""
	if [ "${1:-}" = "--clear" ]; then _clear="--clear"; shift; fi
	for _line in "$@"; do
		# shellcheck disable=SC2086  # $_clear is empty or exactly one flag
		splash_hdmi_run say $_clear "$_line" > /dev/null 2>&1 || true
		_clear=""
	done
	return 0
}

# Called once, right after the early mounts. `up` alone on the happy path; `probe`
# only after a failed `up` that did not time out (docs/installer-init.md#hdmi-splash).
splash_hdmi_init() {
	splash_hdmi=0
	if ! [ -x "$SPLASH_HDMI_BIN" ]; then
		splash_hdmi_log "$SPLASH_HDMI_BIN not present -- no HDMI splash this boot"
		return 0
	fi
	splash_hdmi_run up --mode "$splash_hdmi_mode" > "$SPLASH_HDMI_OUT" 2>&1
	_rc=$?
	splash_hdmi_replay
	if [ "$_rc" -ne 0 ]; then
		splash_hdmi_log "up exit $_rc -- no HDMI splash this boot (the install is unaffected)"
		if [ "$_rc" -ne 124 ]; then
			splash_hdmi_run probe > "$SPLASH_HDMI_OUT" 2>&1
			splash_hdmi_replay
		fi
		return 0
	fi
	splash_hdmi=1
	# Stop fbcon's cursor blinking over the artwork (not persistent, never restored).
	printf '0' > "$SPLASH_HDMI_CURSOR" 2>/dev/null || true
	_img="$(splash_hdmi_image)"
	if [ -f "$_img" ]; then
		# The raw frame is never uncompressed outside the tool's stdin; exit 0 means the
		# bytes reached /dev/fb0.
		zcat "$_img" 2> /dev/null | splash_hdmi_run image - > "$SPLASH_HDMI_OUT" 2>&1
		_rc=$?
		splash_hdmi_replay
		if [ "$_rc" -eq 0 ]; then
			splash_hdmi_log "splash on screen ($splash_hdmi_mode)"
			return 0
		fi
		splash_hdmi_log "image exit $_rc -- screen is up but blank; showing text instead"
	else
		splash_hdmi_log "no $_img -- screen is up; showing text instead"
	fi
	splash_hdmi_say --clear \
		'MiSTer first-time setup' \
		'' \
		'INSTALLING...  Reformatting your SD card.' \
		'DO NOT POWER OFF.' \
		'It reboots itself when it is done. Give it about a minute.'
	return 0
}
# >>> SPLASH SECTION END <<<

log() {
	splash_clear_line
	printf '[installer] %s\n' "$*"
	splash_line
}

# PID 1 must never exit (instant kernel panic): every terminal path respawns a shell.
respawn_shell() {
	while :; do
		setsid cttyhack /bin/sh || /bin/sh || sleep 5
	done
}

# Any fatal error lands here: say where we died ($stage), what the card looks
# like and how to recover, then respawn a shell forever. Nothing is installed.
rescue() {
	# splash_fail first, so the heartbeat cannot redraw over this banner and the
	# LED stops blinking "all is well".
	splash_fail
	printf '\n'
	printf '################################################################\n'
	printf '#  MiSTer INSTALLER: FAILED\n'
	printf '#  %s\n' "$*"
	printf '#  (failed during: %s)\n' "$stage"
	printf '################################################################\n'
	printf '  cmdline    : %s\n' "$cmdline"
	printf '  disk       : %s\n' "$DISK"
	printf '  data part  : %s  (as %s)\n' "$DATA_PART" "$fat_type"
	printf '  card state : %s\n' "$card_state"
	printf '  p1/p2/flag : %s / %s / %s\n' "$P1" "$P2" "$P3"
	printf '  cores kept : %s\n' "$([ "$cores_skipped" = yes ] && echo no || echo yes)"
	printf -- '--- /proc/partitions ---\n';  cat /proc/partitions   2>/dev/null
	printf -- '--- /proc/mounts ---\n';       cat /proc/mounts       2>/dev/null
	printf -- '--- last kernel messages ---\n'; dmesg 2>/dev/null | tail -n 25
	printf '\n'
	printf 'RECOVERY: the safest fix is to re-flash sdcard.img to this card with\n'
	printf 'Etcher or dd and boot again -- that restores a known-good installer.\n'
	printf 'If the card had already been reformatted below, re-flashing is REQUIRED\n'
	printf 'before it will boot again.\n\n'
	printf 'Dropping to a rescue shell on the console. Nothing is installed.\n\n'
	respawn_shell
}

# ------------------------------------------------------------------ TEST HOOK
# stop_after TAG -- simulated power cut (docs/installer-init.md#test-hook).
stop_after() {
	[ -e /.installer-test-hook ] || return 0
	[ "$stop_after_stage" = "$1" ] || return 0
	sync
	splash_pulse_stop
	splash_clear_line
	printf '[installer] TEST-STOP after "%s" -- simulating a power cut here\n' "$1"
	sync
	reboot -f
	rescue "reboot returned after the test stop at $1"
}

# ------------------------------------------------------ the MBR, byte by byte
# >>> MBR SECTION BEGIN -- scripts/test-installer-mbr.sh extracts this VERBATIM and
# checks its bytes against sfdisk's; docs/installer-init.md#partition-layout.
# oct N -- one byte as a printf octal escape; le32 N -- four of them, little-endian.
oct() { printf '\\%03o' "$(( $1 & 255 ))"; }
le32() {
	printf '%s%s%s%s' "$(oct "$1")" "$(oct $(( $1 >> 8 )))" \
		"$(oct $(( $1 >> 16 )))" "$(oct $(( $1 >> 24 )))"
}

# chs LBA -- the 3 CHS bytes libfdisk writes for 255 heads x 63 sectors (FE FF FF past cyl 1023).
chs() {
	_c=$(( $1 / (255 * 63) ))
	if [ "$_c" -gt 1023 ]; then printf '%s' '\376\377\377'; return 0; fi
	printf '%s%s%s' "$(oct $(( ($1 / 63) % 255 )))" \
		"$(oct $(( ($1 % 63 + 1) | ((_c >> 2) & 192) )))" "$(oct "$_c")"
}

# mbr_entry TYPE START SIZE -- one 16-byte partition table entry (not bootable).
mbr_entry() {
	printf '%s%s%s%s%s%s' '\000' "$(chs "$2")" "$(oct "$1")" \
		"$(chs $(( $2 + $3 - 1 )))" "$(le32 "$2")" "$(le32 "$3")"
}

MBR_EMPTY_ENTRY='\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000'

# mbr_build OUT OLD ID E1 E2 E3 E4 -- OLD's boot code (0-439), disk id, 4 entries, 55aa.
mbr_build() {
	dd if="$2" of="$1" bs=440 count=1 2>/dev/null || return 1
	# shellcheck disable=SC2059  # the format IS the bytes: octal escapes built above
	printf "$3\\000\\000$4$5$6$7\\125\\252" >> "$1" || return 1
	[ "$(wc -c < "$1")" -eq 512 ]
}
# >>> MBR SECTION END <<<

# mbr_commit NEW -- write the 512-byte NEW over sector 0 and prove it landed on the card.
mbr_commit() {
	[ "$(wc -c < "$1")" -eq 512 ] || return 1
	dd if="$1" of="$DISK" bs=512 count=1 conv=notrunc,fsync 2>/dev/null || return 1
	sync
	blockdev --flushbufs "$DISK" 2>/dev/null || true
	dd if="$DISK" of=/run/mbr.check bs=512 count=1 2>/dev/null || return 1
	cmp -s "$1" /run/mbr.check
}

# disk_id -- four random bytes as octal escapes (a fresh label gets a new id, as sfdisk does).
disk_id() {
	# shellcheck disable=SC2046  # four decimal words is the point
	set -- $(hexdump -n4 -e '4/1 "%u "' /dev/urandom)
	[ $# -eq 4 ] || return 1
	printf '%s%s%s%s' "$(oct "$1")" "$(oct "$2")" "$(oct "$3")" "$(oct "$4")"
}

# sysfs_is PARTDEV START SIZE -- the kernel's view of one partition, after a re-read.
sysfs_is() {
	_s="/sys/block/$disk_name/${1#/dev/}"
	[ -r "$_s/start" ] && [ -r "$_s/size" ] || return 1
	read -r _a < "$_s/start"; read -r _b < "$_s/size"
	[ "$_a" = "$2" ] && [ "$_b" = "$3" ]
}

flag_state() { "$INSTALL_FLAG" state "$DISK" 2>/dev/null; }

# require_armed WHAT -- re-checked before every destructive step; never trusted from earlier.
require_armed() {
	[ "$(flag_state)" = armed ] || rescue "the installer flag on $DISK is not armed -- refusing to $1"
}

# volume_label PART -- the LABEL BusyBox blkid reports, or nothing.
volume_label() {
	_out="$(blkid "$1" 2>/dev/null)" || return 0
	case "$_out" in *' LABEL="'*) _l="${_out#* LABEL=\"}"; printf '%s' "${_l%%\"*}" ;; esac
}

# ------------------------------------------------------- what /init handed us
# /init mounted /proc, /sys and /dev and saw an armed flag; nothing is taken on trust.
mkdir -p /mnt/src /mnt/dst "$RAM_DIR" /run/preseed
[ -r /proc/cmdline ] && [ -d /sys/block ] && [ -c /dev/null ] ||
	rescue "/init did not hand over /proc, /sys and /dev"
# Everything the destructive steps run, checked before any of them (a partial cpio).
[ -r "$FLAG_CONF" ] && [ -x "$INSTALL_FLAG" ] && [ -x "$MKFS_EXFAT" ] ||
	rescue "this initramfs is missing $FLAG_CONF, $INSTALL_FLAG or $MKFS_EXFAT -- nothing was changed"
# shellcheck source=board/mister/common/initramfs-overlay/usr/lib/mister/install-flag.conf
. "$FLAG_CONF"

# ------------------------------------------------------- parse /proc/cmdline
# Before anything is drawn: the HDMI mode knob lives here. Pure shell, never globs.
stage="parsing the kernel command line"
cmdline="$(cat /proc/cmdline)"
set -f
# shellcheck disable=SC2086  # deliberate word splitting: that IS the parse
set -- $cmdline
for tok in "$@"; do
	case "$tok" in
	# Test hook: user-reachable via u-boot.txt's $v, so stop_after() also requires
	# the initramfs marker file.
	mister_installer_stop_after=*) stop_after_stage="${tok#mister_installer_stop_after=}" ;;
	# HDMI mode knob: 480p for a sink that refuses 720p. User-reachable via $v and
	# harmless by construction, so the cmdline alone may gate it.
	mister_installer_video=*) splash_hdmi_mode="${tok#mister_installer_video=}" ;;
	esac
done
set +f
case "$splash_hdmi_mode" in
720p|480p) ;;
*) log "ignoring mister_installer_video=\"$splash_hdmi_mode\" (720p or 480p); using 720p"
   splash_hdmi_mode=720p ;;
esac

# Picture FIRST: needs only /dev, /sys and the mode. Its logs print plain.
splash_hdmi_init

# The console splash needs /proc, /sys and /run; until now drawing was a no-op.
splash_init
splash_step 1 "checking the card"
if [ -n "$stop_after_stage" ]; then
	if [ -e /.installer-test-hook ]; then
		log "TEST HOOK ACTIVE: will stop after \"$stop_after_stage\""
	else
		log "ignoring mister_installer_stop_after=\"$stop_after_stage\": this is not a test image"
	fi
fi

# ---------------------------------------------- the disk, and its flag, again
# NEVER repartition the wrong disk: the parent is the sysfs dir containing p1.
stage="identifying the boot disk"
[ -n "$DATA_PART" ] && [ -b "$DATA_PART" ] || rescue "/init handed over no data partition ('$DATA_PART')"
DISK="$("$INSTALL_FLAG" disk "$DATA_PART" 2>/dev/null)" || DISK=""
[ -n "$DISK" ] && [ -b "$DISK" ] || rescue "could not find the parent disk of $DATA_PART in sysfs"
disk_name="${DISK#/dev/}"

P1="$(partdev "$DISK" 1)"
P2="$(partdev "$DISK" 2)"
P3="$(partdev "$DISK" 3)"
# Stock U-Boot only boots partition 1: refuse any other layout rather than guess.
[ "$DATA_PART" = "$P1" ] || rescue "data partition $DATA_PART is not p1 ($P1) of $DISK"
require_armed "install onto this card"
log "disk=$DISK  p1(data)=$P1  p2(boot)=$P2  flag=$P3 (armed)"

# --------------------------------------------------- mount the source read-only
# Read-only; exfat first, so a card this installer already formatted is recognised.
stage="mounting the source data partition"
if mount -t exfat -o ro "$DATA_PART" /mnt/src 2>/dev/null; then
	fat_type="exfat"
elif mount -t vfat -o ro "$DATA_PART" /mnt/src 2>/dev/null; then
	fat_type="vfat"
else
	rescue "cannot mount $DATA_PART as exfat or vfat"
fi
log "source mounted ($fat_type)"

# ------------------------------------------------------ what is on this card?
# One decision over the card states (docs/installer-init.md#recoverability).
stage="assessing the card"
SRC_PAYLOAD="/mnt/src/$PAYLOAD_DIR"
SRC_PAYLOAD_PART="/mnt/src/$PAYLOAD_PART_DIR"
SRC_KERNEL="/mnt/src/linux/zImage_dtb"
SRC_MENU_RBF="/mnt/src/menu.rbf"
label="$(volume_label "$DATA_PART")"
payload_complete() {
	[ -d "$SRC_PAYLOAD" ] && [ -s "$SRC_PAYLOAD/linux/linux.img.gz" ] &&
		[ -s "$SRC_PAYLOAD/linux/uboot.img" ]
}
ours=0
[ "$fat_type" = exfat ] && [ "$label" = "$DATA_LABEL" ] && [ -f "/mnt/src/$INSTALL_TOKEN" ] && ours=1

# INTERRUPTED DURING THE COPY-BACK: its source was in RAM and is gone. Halt; a
# reboot would only come back here.
if [ -d "$SRC_PAYLOAD_PART" ] && [ ! -d "$SRC_PAYLOAD" ]; then
	umount /mnt/src 2>/dev/null || true
	splash_fail
	printf '\n################################################################\n'
	printf '#  MiSTer INSTALLER: the previous install was INTERRUPTED\n'
	printf '################################################################\n'
	printf '  %s holds %s/, a partial copy.\n' "$DATA_PART" "$PAYLOAD_PART_DIR"
	printf '  The install was cut short while writing files to the card, and\n'
	printf '  the files it was copying from were held in RAM -- they are gone.\n'
	printf '  There is nothing left on this card to install from.\n\n'
	printf 'RECOVERY: re-flash sdcard.img to this card with Etcher or dd and boot\n'
	printf 'again. Nothing else is needed, and nothing on the board was harmed.\n\n'
	printf 'Dropping to a console shell. Nothing is installed.\n\n'
	respawn_shell
fi

if [ "$fat_type" = vfat ] && payload_complete; then
	card_state="fresh"
elif [ "$ours" = 1 ] && payload_complete; then
	card_state="resume"
elif [ "$fat_type" = exfat ] && ! payload_complete &&
     [ -s /mnt/src/linux/linux.img ] && [ -s "$SRC_KERNEL" ]; then
	card_state="finish"
elif [ "$ours" = 1 ]; then
	rescue "no complete /$PAYLOAD_DIR on an exFAT $DATA_PART -- an install was interrupted before the payload was copied; re-flash sdcard.img"
else
	card_state="foreign"
fi
log "card state: $card_state"

# ------------------------------------------------- finish_install (step 10)
# The tail every completed copy reaches, and the whole of a "finish" boot. Idempotent.
commit_payload() {
	[ -d "$DST_PAYLOAD" ] || return 0
	for entry in "$DST_PAYLOAD"/* "$DST_PAYLOAD"/.[!.]*; do
		[ -e "$entry" ] || continue
		if [ "${entry##*/}" = "linux" ]; then
			for sub in "$entry"/* "$entry"/.[!.]*; do
				[ -e "$sub" ] || continue
				mv -f "$sub" /mnt/dst/linux/ || return 1
			done
			continue
		fi
		mv -f "$entry" /mnt/dst/ || return 1
	done
	return 0
}

apply_preseed() {
	# $1 = name under $PRESEED_DIR on the card ; $2 = destination path under /mnt/dst
	[ -e "/mnt/dst/$PRESEED_DIR/$1" ] || return 0
	dest="/mnt/dst/$2"
	mkdir -p "${dest%/*}"
	if cp -a "/mnt/dst/$PRESEED_DIR/$1" "$dest" 2>/dev/null; then
		log "pre-seed applied: $1 -> $2"
	else
		log "pre-seed: WARNING failed to apply $1 (ignored)"
	fi
}

# Random locally-administered unicast MAC; u-boot.txt must end in a newline.
gen_mac() {
	# shellcheck disable=SC2046  # hexdump's hex-only words into $1..$6 is the point
	set -- $(hexdump -n6 -e '6/1 "%02x "' /dev/urandom)
	[ $# -eq 6 ] || return 1
	o1=$(( (0x$1 | 0x02) & 0xFE ))
	printf '%02X:%02X:%02X:%02X:%02X:%02X' \
		"$o1" "$((0x$2))" "$((0x$3))" "$((0x$4))" "$((0x$5))" "$((0x$6))"
}

# flag_spend -- THE COMMIT POINT: wipe the magic block, so the probe says "spent" (a normal
# boot). One 512-byte write that never touches sector 0, read back before it counts.
flag_spend() {
	dd if=/dev/zero of="$DISK" bs=512 seek="$FLAG_LBA" count=1 conv=notrunc,fsync 2>/dev/null || return 1
	sync
	blockdev --flushbufs "$DISK" 2>/dev/null || true
	[ "$(flag_state)" = spent ]
}

# flag_remove_entry -- cleanup after the commit: entry 3 leaves the MBR, all else kept.
flag_remove_entry() {
	dd if="$DISK" of=/run/mbr.old bs=512 count=1 2>/dev/null || return 1
	{
		dd if=/run/mbr.old bs=478 count=1 2>/dev/null
		# shellcheck disable=SC2059  # sixteen octal NULs, built above
		printf "$MBR_EMPTY_ENTRY"
		dd if=/run/mbr.old bs=1 skip=494 count=18 2>/dev/null
	} > /run/mbr.new || return 1
	mbr_commit /run/mbr.new
}

finish_install() {
	splash_step 10 "finishing the install"
	DST_PAYLOAD="/mnt/dst/$PAYLOAD_DIR"
	if [ -f "/mnt/dst/$INSTALL_TOKEN" ]; then
		# Drop the redundant .gz, then VERIFY and fall back to truncating: an unchecked
		# `rm` once silently no-opped for a release (docs/installer-init.md#commit-phase).
		stage="removing the compressed system image"
		if [ -e "$DST_PAYLOAD/linux/linux.img.gz" ]; then
			rm -f "$DST_PAYLOAD/linux/linux.img.gz" 2>/dev/null
			if [ -e "$DST_PAYLOAD/linux/linux.img.gz" ]; then
				: > "$DST_PAYLOAD/linux/linux.img.gz"
				log "WARNING: could not delete linux/linux.img.gz -- truncated it instead"
			else
				log "removed linux/linux.img.gz"
			fi
		fi

		stage="moving the payload into place"
		commit_payload || rescue "moving the payload into place on $P1 failed"
		sync
		for f in linux/linux.img linux/uboot.img linux/zImage_dtb; do
			[ -s "/mnt/dst/$f" ] || rescue "$f missing on $P1 after the commit moves"
		done
		log "payload moved into place on $P1"
		stop_after moved

		stage="applying user pre-seed"
		apply_preseed wpa_supplicant.conf  linux/wpa_supplicant.conf
		apply_preseed _wpa_supplicant.conf linux/_wpa_supplicant.conf
		apply_preseed samba.sh             linux/_samba.sh
		apply_preseed _samba.sh            linux/_samba.sh
		# Directory pre-seeds are merged (cp -a of the dir onto the existing tree).
		for d in Scripts config; do
			[ -d "/mnt/dst/$PRESEED_DIR/$d" ] || continue
			if cp -a "/mnt/dst/$PRESEED_DIR/$d" /mnt/dst/; then log "pre-seed applied: $d/"; else log "pre-seed: WARNING $d/ failed (ignored)"; fi
		done

		# A resumed "finish" boot keeps the MAC its first attempt already wrote.
		stage="writing per-board MAC"
		if [ -s /mnt/dst/linux/u-boot.txt ]; then
			log "linux/u-boot.txt already present -- keeping its MAC"
		elif mac="$(gen_mac)" && [ -n "$mac" ]; then
			printf 'ethaddr=%s\n' "$mac" > /mnt/dst/linux/u-boot.txt ||
				rescue "cannot write /linux/u-boot.txt on $P1"
			log "per-board MAC = $mac"
		else
			log "WARNING: could not generate a MAC; board will use the shared fallback"
		fi

		stage="removing the staged payload"
		rm -rf "$DST_PAYLOAD" 2>/dev/null
		if [ -e "$DST_PAYLOAD" ]; then
			log "WARNING: could not remove $PAYLOAD_DIR/ from $P1 (harmless clutter)"
		else
			log "removed $PAYLOAD_DIR/ from $P1"
		fi
		rm -rf "/mnt/dst/$PRESEED_DIR" 2>/dev/null ||
			log "WARNING: could not remove $PRESEED_DIR/ (harmless clutter)"
		rm -f "/mnt/dst/$INSTALL_TOKEN" 2>/dev/null ||
			log "WARNING: could not remove $INSTALL_TOKEN (harmless once the flag is gone)"
	else
		log "no $INSTALL_TOKEN on $P1 -- nothing to move; only the flag is left to remove"
	fi

	stage="flushing the data partition"
	sync
	umount /mnt/dst || rescue "cannot unmount $P1 (data not fully flushed)"
	sync

	# ====================== THE COMMIT POINT ===============================
	# Before it the next boot finishes this install; after it, the card boots MiSTer.
	stage="spending the installer flag (the commit point)"
	require_armed "commit the install"
	flag_spend || rescue "could not spend the installer flag on $DISK"
	log "installer flag spent -- this card is a MiSTer now, not an installer"
	stop_after committed

	# Cleanup only: a spent entry 3 already boots normally, so a failure here is harmless.
	stage="removing the spent flag's partition entry"
	if flag_remove_entry && [ "$(flag_state)" = absent ]; then
		log "flag partition entry removed from the MBR"
	else
		log "WARNING: could not remove MBR entry 3 (harmless: the flag is spent)"
	fi
	blockdev --rereadpt "$DISK" 2>/dev/null || true
	[ "$(flag_state)" != armed ] || rescue "the installer flag still reads as armed after the commit"

	stage="rebooting into the installed MiSTer"
	# Draws the completion banner and puts the LED out: from here the next thing that
	# lights it is the installed system's own mmc0 trigger, one boot from now.
	splash_done
	log "install complete -- rebooting into MiSTer"
	sync
	# `reboot -f`: direct reboot(2) syscall; we ARE pid 1 and nothing else would act on it.
	reboot -f
	rescue "reboot returned unexpectedly"
}

# FOREIGN: an armed flag on a card this installer did not make and cannot install from
# (repartitioned, reformatted). Spend the flag and boot it normally; never rescue-loop.
if [ "$card_state" = foreign ]; then
	umount /mnt/src 2>/dev/null || true
	stage="spending the installer flag on a card it will not install to"
	log "$DATA_PART ($fat_type, label '$label') is not a card this installer can finish -- leaving it as it is"
	require_armed "spend the flag"
	flag_spend || rescue "could not spend the installer flag on $DISK"
	log "installer flag spent; nothing else on $DISK was changed -- rebooting into a normal boot"
	sync
	reboot -f
	rescue "reboot returned unexpectedly"
fi

if [ "$card_state" = finish ]; then
	stage="remounting $P1 read-write"
	umount /mnt/src || rescue "cannot unmount $DATA_PART"
	mount -t exfat -o rw,noatime "$P1" /mnt/dst || rescue "cannot mount $P1 read-write"
	finish_install
fi

# ------------------------------------------------- the payload and boot files
splash_step 2 "reading the payload"
stage="checking the kernel"
[ -s "$SRC_KERNEL" ] || rescue "no linux/zImage_dtb at the card root -- refusing to reformat a card it could not boot again"
[ -f "$SRC_MENU_RBF" ] ||
	log "WARNING: no menu.rbf at the card root -- the fabric stays unconfigured on a re-run"

# --------------------------------------------------- stash any user pre-seed (2)
# Optional files at the FAT root (mr-fusion's hooks), stashed in RAM for step 10.
stage="collecting user pre-seed"
preseed_src="/mnt/src"
[ "$card_state" = resume ] && preseed_src="/mnt/src/$PRESEED_DIR"
for item in wpa_supplicant.conf _wpa_supplicant.conf samba.sh _samba.sh Scripts config; do
	if [ -e "$preseed_src/$item" ]; then
		if cp -a "$preseed_src/$item" "/run/preseed/$item" 2>/dev/null; then
			log "pre-seed: captured $item"
		else
			log "pre-seed: WARNING could not capture $item (ignored)"
		fi
	fi
done

# ------------------------------------------------ copy the payload into RAM (3)
# tmpfs sized so a mis-estimate is ENOSPC, not OOM (docs/installer-init.md#ram-budget).
stage="measuring RAM"
avail_kb=0
while read -r key val _; do
	[ "$key" = "MemAvailable:" ] && { avail_kb="$val"; break; }
done < /proc/meminfo
case "$avail_kb" in ''|*[!0-9]*) avail_kb=0 ;; esac
budget_kb=$((avail_kb - RAM_RESERVE_KB))
[ "$budget_kb" -gt 0 ] || rescue "not enough free RAM to stage the payload (avail=${avail_kb}KB)"

mount -t tmpfs -o "size=${budget_kb}k" tmpfs "$RAM_DIR" ||
	rescue "cannot mount the payload tmpfs (${budget_kb}KB)"
mkdir -p "$RAM_PAYLOAD" "$RAM_BOOT" || rescue "cannot create the RAM staging dirs"

# The boot files live outside $SRC_PAYLOAD and are never dropped, so they are
# budgeted into the base explicitly.
payload_kb="$(du -sk "$SRC_PAYLOAD" 2>/dev/null | cut -f1)"
cores_kb=0
[ -d "$SRC_PAYLOAD/$CORES_DIR" ] && cores_kb="$(du -sk "$SRC_PAYLOAD/$CORES_DIR" 2>/dev/null | cut -f1)"
boot_kb="$(du -sk "$SRC_KERNEL" 2>/dev/null | cut -f1)"
rbf_kb=0
[ -f "$SRC_MENU_RBF" ] && rbf_kb="$(du -sk "$SRC_MENU_RBF" 2>/dev/null | cut -f1)"
case "$payload_kb" in ''|*[!0-9]*) payload_kb=0 ;; esac
case "$cores_kb"   in ''|*[!0-9]*) cores_kb=0 ;;   esac
case "$boot_kb"    in ''|*[!0-9]*) boot_kb=0 ;;    esac
case "$rbf_kb"     in ''|*[!0-9]*) rbf_kb=0 ;;     esac
boot_kb=$((boot_kb + rbf_kb))
full_kb=$((payload_kb + boot_kb))
base_kb=$((full_kb - cores_kb))
log "payload: full=${full_kb}KB (cores=${cores_kb}KB, boot files=${boot_kb}KB, base=${base_kb}KB); RAM budget=${budget_kb}KB"

skip_cores=0
if [ "$full_kb" -gt "$budget_kb" ]; then
	skip_cores=1
	cores_skipped="yes"
	if [ "$base_kb" -gt "$budget_kb" ]; then
		rescue "even the base payload (${base_kb}KB) exceeds the RAM budget (${budget_kb}KB)"
	fi
	printf '\n****************************************************************\n'
	printf '*  RAM is too small to stage the _Console cores this boot.\n'
	printf '*  Installing the BASE system only; SKIPPING cores.\n'
	printf '*  Run update_all.sh after first boot to fetch cores.\n'
	printf '****************************************************************\n\n'
fi

splash_step 3 "copying to memory"
stage="copying the payload into RAM"
copy_payload_to_ram() {
	# Copy each top-level entry; skip the cores dir when RAM is tight.
	for entry in "$SRC_PAYLOAD"/* "$SRC_PAYLOAD"/.[!.]*; do
		[ -e "$entry" ] || continue
		name="${entry##*/}"
		if [ "$skip_cores" = 1 ] && [ "$name" = "$CORES_DIR" ]; then
			log "skipping cores dir $name (RAM)"
			continue
		fi
		cp -a "$entry" "$RAM_PAYLOAD"/ || return 1
	done
	# The boot pair, into their own directory so the copy-back glob above never sees them.
	cp -a "$SRC_KERNEL" "$RAM_BOOT/zImage_dtb" || return 1
	if [ -f "$SRC_MENU_RBF" ]; then
		cp -a "$SRC_MENU_RBF" "$RAM_BOOT/menu.rbf" || return 1
	fi
	return 0
}
# One long, silent, blocking command: bracket it with the heartbeat child so the
# console clock keeps ticking and the LED keeps blinking while it runs.
splash_pulse_start
copy_payload_to_ram || rescue "copying the payload into RAM failed (out of space?)"
splash_pulse_stop

# Verify the RAM copy BEFORE destroying anything; the card is still an installer.
for f in "$RAM_PAYLOAD/linux/linux.img.gz" "$RAM_PAYLOAD/linux/uboot.img" "$RAM_BOOT/zImage_dtb"; do
	[ -s "$f" ] || rescue "the RAM copy is missing ${f#"$RAM_DIR"/} -- aborting before reformat"
done
log "payload and kernel staged in RAM OK"

# We are done reading the card. Everything destructive is below this line.
stage="unmounting the source"
umount /mnt/src || rescue "cannot unmount $DATA_PART before repartitioning"
sync

# =========== POINT OF NO RETURN -- from here the card is being rewritten ===========

# -------------------------- uboot.img to where p2 is about to be (4)
# BEFORE the MBR names it, so no instant exists where p2 points at a region without it.
splash_step 4 "writing the bootloader"
stage="sizing the new layout of $DISK"
dev_sectors="$(cat "/sys/block/$disk_name/size" 2>/dev/null)"
case "$dev_sectors" in ''|*[!0-9]*) rescue "cannot read /sys/block/$disk_name/size" ;; esac
[ "$dev_sectors" -le "$MBR_MAX_SECTORS" ] ||
	rescue "card has $dev_sectors sectors; an MBR cannot address past 2 TiB -- nothing was changed"
data_sectors=$((dev_sectors - P1_START_SECTORS - RESERVED_SECTORS))
p2_start=$((dev_sectors - RESERVED_SECTORS))
[ "$data_sectors" -gt 0 ] || rescue "device too small: $dev_sectors sectors"
log "card=$dev_sectors sectors; p1=[$P1_START_SECTORS,+$data_sectors) exfat; p2=[$p2_start,+$RESERVED_SECTORS) 0xA2; flag=[$FLAG_LBA,+$FLAG_SECTORS)"

# The new p2 must lie outside every partition the card has now, or BE the current p2 (resume).
for _sys in "/sys/block/$disk_name/$disk_name"*; do
	[ -r "$_sys/start" ] && [ -r "$_sys/size" ] || continue
	read -r _a < "$_sys/start"; read -r _b < "$_sys/size"
	[ "$_a" = "$p2_start" ] && [ "$_b" = "$RESERVED_SECTORS" ] && continue
	[ $((_a + _b)) -le "$p2_start" ] ||
		rescue "the new boot partition would overlap ${_sys##*/} -- nothing was changed"
done

# Padded to whole sectors so the read-back below compares exactly what was written.
uboot_pad=/run/uboot.pad
dd if="$RAM_PAYLOAD/linux/uboot.img" of="$uboot_pad" bs=512 conv=sync 2>/dev/null ||
	rescue "cannot stage uboot.img -- nothing was changed"
uboot_sectors=$(( $(wc -c < "$uboot_pad") / 512 ))
[ "$uboot_sectors" -gt 0 ] && [ "$uboot_sectors" -le "$RESERVED_SECTORS" ] ||
	rescue "uboot.img does not fit the $RESERVED_SECTORS-sector boot partition -- nothing was changed"
# uboot_matches DEV SKIP -- the sectors at DEV+SKIP equal the padded uboot.img.
uboot_matches() {
	dd if="$1" bs=512 skip="$2" count="$uboot_sectors" 2>/dev/null | cmp -s - "$uboot_pad"
}

stage="writing uboot.img ahead of the new boot partition"
require_armed "write the bootloader"
splash_pulse_start
dd if="$uboot_pad" of="$DISK" bs=512 seek="$p2_start" conv=notrunc,fsync 2>/dev/null ||
	rescue "writing uboot.img at LBA $p2_start failed -- the partition table is unchanged"
sync
blockdev --flushbufs "$DISK" 2>/dev/null || true
splash_pulse_stop
uboot_matches "$DISK" "$p2_start" ||
	rescue "uboot.img at LBA $p2_start did not read back -- the partition table is unchanged"
log "uboot.img staged at LBA $p2_start, where the new boot partition will start"
stop_after uboot-staged

# ------------------------------------------------- repartition to full size (5)
# Explicit starts and sizes; entry 3 (the flag) is rewritten unchanged, so a cut here re-runs.
splash_step 5 "repartitioning the card"
stage="repartitioning $DISK"
id="$(disk_id)" || rescue "could not read /dev/urandom for a disk id -- nothing was changed"
dd if="$DISK" of=/run/mbr.old bs=512 count=1 2>/dev/null || rescue "cannot read the MBR of $DISK"
mbr_build /run/mbr.new /run/mbr.old "$id" \
	"$(mbr_entry 7 "$P1_START_SECTORS" "$data_sectors")" \
	"$(mbr_entry 0xa2 "$p2_start" "$RESERVED_SECTORS")" \
	"$(mbr_entry "$FLAG_TYPE" "$FLAG_LBA" "$FLAG_SECTORS")" \
	"$MBR_EMPTY_ENTRY" || rescue "could not assemble the new partition table -- nothing was changed"
require_armed "repartition this card"
mbr_commit /run/mbr.new || rescue "writing the new partition table to $DISK failed or did not verify"

# Make the kernel re-read the new table and prove it sees exactly what we wrote.
stage="re-reading the partition table"
waited=0
while :; do
	blockdev --rereadpt "$DISK" 2>/dev/null &&
		sysfs_is "$P1" "$P1_START_SECTORS" "$data_sectors" &&
		sysfs_is "$P2" "$p2_start" "$RESERVED_SECTORS" &&
		sysfs_is "$P3" "$FLAG_LBA" "$FLAG_SECTORS" &&
		[ -b "$P1" ] && [ -b "$P2" ] && break
	[ "$waited" -ge "$DEV_WAIT" ] && rescue "the kernel never showed the new partitions $P1 / $P2 / $P3"
	splash_tick   # this loop already sleeps 1, so it animates without a child
	sleep 1; waited=$((waited + 1))
done
require_armed "continue after repartitioning"
log "new partitions present: $P1 (data), $P2 (boot), $P3 (flag, still armed)"

# Through the new partition node this time: the BootROM's view of p2.
stage="checking uboot.img in the boot partition ($P2)"
uboot_matches "$P2" 0 ||
	rescue "$P2 does not hold uboot.img after the repartition -- card is NOT bootable; re-flash sdcard.img"
log "uboot.img verified in $P2 -- the card can reach U-Boot again"
stop_after bootloader

# --------------------------------------------------- mkfs.exfat on new p1 (6)
splash_step 6 "formatting (exFAT)"
stage="formatting $P1 as exFAT"
require_armed "format $P1"
"$MKFS_EXFAT" -n "$DATA_LABEL" "$P1" || rescue "mkfs.exfat on $P1 failed"
sync

stage="mounting the new data partition"
mount -t exfat -o rw,noatime "$P1" /mnt/dst || rescue "cannot mount new exFAT $P1"

# ------------------------------- put the boot files back on the card first (7)
# U-Boot loads menu.rbf and zImage_dtb off p1, and the flag is still armed: a cut re-runs us.
splash_step 7 "making the card recoverable"
stage="writing the kernel onto $P1"
mkdir -p /mnt/dst/linux || rescue "cannot create linux/ on $P1"
printf 'MiSTer first-boot install in progress; the installer removes this file.\n' \
	> "/mnt/dst/$INSTALL_TOKEN" || rescue "cannot write $INSTALL_TOKEN on $P1"
cp -a "$RAM_BOOT/zImage_dtb" /mnt/dst/linux/zImage_dtb ||
	rescue "cannot write the kernel to linux/zImage_dtb on $P1"
log "kernel on $P1 -- from here a power cut re-runs the installer"
if [ -f "$RAM_BOOT/menu.rbf" ]; then
	if cp -a "$RAM_BOOT/menu.rbf" /mnt/dst/menu.rbf; then
		log "menu.rbf on $P1 (the core U-Boot fpgaload puts in the fabric)"
	else
		log "WARNING: could not write menu.rbf (ignored -- it configures the fabric, nothing more)"
	fi
fi
sync
stop_after recoverable

# ------------------------------------------- copy the payload back out of RAM (8)
# Into .part/, renamed when complete: the rename is what the next boot tests.
splash_step 8 "writing files to the card"
stage="writing the payload to the card"
DST_PAYLOAD="/mnt/dst/$PAYLOAD_DIR"
DST_PAYLOAD_PART="/mnt/dst/$PAYLOAD_PART_DIR"
# Before the payload, so any card that reaches "finish" or "resume" carries them too.
if ! { mkdir -p "/mnt/dst/$PRESEED_DIR" && cp -a /run/preseed/. "/mnt/dst/$PRESEED_DIR/"; }; then
	rescue "cannot stage the user pre-seed on $P1"
fi
mkdir -p "$DST_PAYLOAD_PART" || rescue "cannot create $PAYLOAD_PART_DIR on $P1"
splash_pulse_start
for entry in "$RAM_PAYLOAD"/* "$RAM_PAYLOAD"/.[!.]*; do
	[ -e "$entry" ] || continue
	cp -a "$entry" "$DST_PAYLOAD_PART/" || rescue "copying ${entry##*/} onto $P1 failed"
	stop_after payload-partial
done
sync
splash_pulse_stop

# Rename only once the boot-critical files are there: never a partial "complete".
for f in linux/linux.img.gz linux/uboot.img; do
	[ -s "$DST_PAYLOAD_PART/$f" ] || rescue "$f missing on $P1 after copy-back"
done
stage="committing the payload directory"
mv "$DST_PAYLOAD_PART" "$DST_PAYLOAD" ||
	rescue "cannot rename $PAYLOAD_PART_DIR to $PAYLOAD_DIR on $P1"
sync
log "payload written to $P1 as $PAYLOAD_DIR/ -- this card can now finish on its own"
stop_after payload-copied

# ------------------------------------ expand linux.img.gz onto the card (9)
# To disk, never RAM; the payload stays intact, so a cut here re-installs.
splash_step 9 "expanding the system image"
stage="expanding linux.img onto the card"
[ -s "$DST_PAYLOAD/linux/linux.img.gz" ] || rescue "linux/linux.img.gz missing on $P1 after copy-back"
# The longest command of the install, with no progress of its own.
splash_pulse_start
zcat "$DST_PAYLOAD/linux/linux.img.gz" > /mnt/dst/linux/linux.img ||
	rescue "decompressing linux/linux.img.gz onto $P1 failed (card out of space, or corrupt payload)"
splash_pulse_stop
sync
stop_after expanded

finish_install
