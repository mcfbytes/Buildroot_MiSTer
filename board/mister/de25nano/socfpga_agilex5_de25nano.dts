// SPDX-License-Identifier: GPL-2.0-only
/*
 * Terasic DE25-Nano — Intel/Altera Agilex 5 (A5EB013BB23BE4S)
 *
 * Board device tree for mainline Linux 7.3.x, on top of mainline's
 * socfpga_agilex5.dtsi. Rationale per node: docs/de25-dts-rationale.md.
 *
 * Copyright (C) 2023, Intel Corporation           (upstream socfpga_agilex5)
 * Copyright (C) 2025, Altera Corporation          (DE25-Nano board wiring)
 */

#include "arm64/intel/socfpga_agilex5.dtsi"

/ {
	/* altera.yaml's Agilex 5 board list is a closed enum; identity lives in "model". */
	model = "Terasic DE25-Nano";
	compatible = "intel,socfpga-agilex5-socdk", "intel,socfpga-agilex5";

	aliases {
		serial0 = &uart1;
		/* Load-bearing: U-Boot writes $ethaddr into the node this alias names. */
		ethernet0 = &gmac0;
		i2c1 = &i2c1;
	};

	chosen {
		/* No bootargs: U-Boot's fdt_chosen() overwrites them from $bootargs. */
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		/* /sys/class/leds/hps_led0 comes from "label", same ABI as the DE10. */
		led-0 {
			label = "hps_led0";
			gpios = <&portb 17 GPIO_ACTIVE_LOW>;
		};
	};

	/* 1 GiB fallback; U-Boot rewrites this node from the IO96B readout. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	/* No fpga-bridges and no config-complete-timeout-us: docs/de25-fpga-reconfig.md §4. */
	base_fpga_region: fpga-region {
		compatible = "fpga-region";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		fpga-mgr = <&fpga_mgr>;
	};
};

&{/firmware/svc} {
	/* Selects the physical-address SMC path our BL31 serves: docs/de25-vendor-kernel-delta.md §3. */
	compatible = "intel,agilex-svc";

	/* Two strings: the stock driver binds through the second. */
	fpga_mgr: fpga-mgr {
		compatible = "intel,agilex5-soc-fpga-mgr",
			     "intel,agilex-soc-fpga-mgr";
	};
};

/* Off by decision (ADR 0029 D10, ADR 0034); every iommus property is kept and inert. */
&smmu {
	status = "disabled";
};

&soc {
	/* Absent from mainline's dtsi. The block is an SD6HC; this binds the SD4HC driver. */
	mmc0: mmc@10808000 {
		compatible = "intel,agilex5-sd4hc", "cdns,sd4hc";
		reg = <0x10808000 0x1000>;
		interrupts = <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>;
		resets = <&rst SDMMC_RESET>;
		clocks = <&clkmgr AGILEX5_L4_MP_CLK>,
			 <&clkmgr AGILEX5_SDMCLK>;
		clock-names = "biu", "ciu";
		iommus = <&smmu 5>;
		/* No dma-coherent until measured with the SMMU off: docs/de25-dts-rationale.md §4.5. */

		bus-width = <4>;
		/* Default speed at 25 MHz, the mode U-Boot leaves the PHY in. Never add cdns,phy-*. */
		max-frequency = <25000000>;
		disable-wp;
		no-1-8-v;
		no-sdio;

		/* <caps1 caps>: 200 MHz base clock; mask SDR50 tuning and high speed (bit 21). */
		sdhci-caps = <0x00000000 0x0000c800>;
		sdhci-caps-mask = <0x00002000 0x0020ff00>;

		status = "okay";
	};
};

&gmac0 {
	status = "okay";
	/* "rgmii", not "rgmii-id": the TX/RX delays are on the PCB. */
	phy-mode = "rgmii";
	phy-handle = <&emac0_phy0>;
	max-frame-size = <9000>;
	/* Same first-boot rule as mmc0: docs/de25-dts-rationale.md §4.5. */
	/delete-property/ dma-coherent;

	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		emac0_phy0: ethernet-phy@1 {
			reg = <1>;
		};
	};
};

&gpio1 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&usb0 {
	status = "okay";
	disable-over-current;
};

/* All five enabled: a watchdog firmware started is only petted if its node is. */
&watchdog0 {
	status = "okay";
};

&watchdog1 {
	status = "okay";
};

&watchdog2 {
	status = "okay";
};

&watchdog3 {
	status = "okay";
};

&watchdog4 {
	status = "okay";
};

/* Root of the peripheral clock tree; mainline declares it at 0 Hz. */
&osc1 {
	clock-frequency = <25000000>;
};
