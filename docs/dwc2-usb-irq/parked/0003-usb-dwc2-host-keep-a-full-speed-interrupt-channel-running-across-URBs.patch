+		dwc2_complete_non_isoc_xfer_ddma(hsotg, chan, i,
+						 DWC2_HC_XFER_URB_DEQUEUE);
+		dwc2_release_channel_ddma(hsotg, qh);
+		dwc2_hcd_qh_unlink(hsotg, qh);
