--- a/drivers/mmc/sdhci-cadence.c
+++ b/drivers/mmc/sdhci-cadence.c
@@ -18,6 +18,7 @@
 #include <mmc.h>
 #include <reset.h>
 #include <sdhci.h>
+#include <generic-phy.h>
 #include "sdhci-cadence.h"
 
 struct sdhci_cdns_phy_cfg {
@@ -263,6 +264,31 @@
 	if (!ret)
 		reset_deassert_bulk(&reset_bulk);
 
+	/*
+	 * Cadence ComboPHY (Intel Agilex 5 SD analog frontend): initialise
+	 * before any card traffic, in the same order as the vendor
+	 * (Terasic u-boot-socfpga de25-nano-v2025.01) sdhci-cadence: release
+	 * host resets -> generic_phy_init -> mmc_of_parse -> PHY params.
+	 * The ComboPHY driver/ node are board additions (see
+	 * phy-cadence-combophy.c). A board without the "combo-phy" property
+	 * simply skips this.
+	 */
+	if (CONFIG_IS_ENABLED(PHY)) {
+		struct phy combo_phy;
+
+		ret = generic_phy_get_by_name(dev, "combo-phy", &combo_phy);
+		if (!ret) {
+			ret = generic_phy_init(&combo_phy);
+			if (ret) {
+				dev_err(dev, "combo-phy init failed: %d\n", ret);
+				return ret;
+			}
+			ret = generic_phy_power_on(&combo_phy);
+			if (ret)
+				dev_warn(dev, "combo-phy power_on: %d\n", ret);
+		}
+	}
+
 	host->name = dev->name;
 	host->ioaddr = plat->hrs_addr + SDHCI_CDNS_SRS_BASE;
 	host->ops = &sdhci_cdns_ops;
