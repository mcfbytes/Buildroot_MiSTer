config BR2_PACKAGE_ITSALIVE
	bool "itsalive"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	help
	  Brings up HDMI and the Linux framebuffer on a MiSTer without
	  Main_MiSTer running: programs the video PLL, the timings and
	  the ADV7513 over the fabric mailbox and i2c, then points the
	  fabric's frame reader at /dev/fb0 -- the same register
	  sequences Main_MiSTer runs, transcribed from it, needing only
	  the menu.rbf U-Boot has already loaded.

	  Its job in this tree is the SD-card installer's first-boot
	  splash (ADR 0020 section 9, issue #185): for the minute the
	  card is being reformatted the board otherwise shows nothing on
	  HDMI, and a first-time user reaches for the power switch at
	  exactly the moment that bricks the card. `itsalive up` then
	  `itsalive image` put "installing, do not power off" on screen.
	  It is also a rescue tool: a shell on a MiSTer with a core
	  loaded gets a screen back with two commands.

	  About 900 KB static on glibc. It ships in exactly one place,
	  the DE10 stage-1 initramfs (BR2_PACKAGE_MISTER_INITRAMFS_ITSALIVE,
	  which keeps it out of the rootfs), where both the first-boot
	  installer (ADR 0033) and the exFAT repair (ADR 0026) use it.
	  Never run it while Main_MiSTer is up: two writers on the
	  mailbox corrupt each other.

	  https://github.com/mcfbytes/ItsAlive_MiSTer

# On a musl toolchain Rust's arch gate also needs BR2_TOOLCHAIN_BUILDROOT_CXX=y
# (package/rustc/Config.in.host); every configuration in this tree is glibc now.
comment "itsalive needs a Rust-supported toolchain (on musl: BR2_TOOLCHAIN_BUILDROOT_CXX=y)"
	depends on BR2_arm
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
