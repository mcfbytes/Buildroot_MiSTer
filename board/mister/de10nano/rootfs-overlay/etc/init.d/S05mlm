#!/bin/sh
# shellcheck shell=sh
# S05mlm -- MiSTer Linux Modernization: keep this project's update channel wired
# up on /media/fat, every boot.
#
# WHY THIS EXISTS (read before deleting anything here):
#
#   /media/fat is not ours. Update All rewrites downloader.ini, users edit it,
#   other scripts touch it, and the whole partition survives a root filesystem
#   reflash. The root filesystem, by contrast, IS ours and is replaced wholesale
#   on every release. So the root filesystem holds the canonical copies and this
#   script pushes them onto the card. That inverts the failure mode: instead of
#   "something rewrote our config and we are silently disabled forever", it
#   becomes "something rewrote our config, it was put back at the next boot, and
#   the fact that it happened is in the log".
#
#   It is also how an existing card picks up a CORRECTED updater script. A
#   release_YYYYMMDD.7z can only carry files/linux/**, so it can never write
#   /media/fat/Scripts/ -- but it carries linux.img, and linux.img carries this
#   script and the canonical copies. Shipping a new updater is therefore just a
#   normal image update, and db.json's files{} can stay empty forever.
#
# It NEVER runs the Downloader and never touches the network. All local-store
# mutation stays on the user-initiated path, so this can never collide with an
# update_all.sh run.
#
# /media/fat is already mounted here: the initramfs does
# `mount -o move /mnt/fat /newroot/media/fat` before switch_root, and inittab
# reaches rcS afterwards. S05 runs well before S99user, which is what the revert
# detector needs -- the state file must be fresh before the detector reads it.
#
# Everything is best-effort and backgrounded: this must never fail or delay a
# boot, so it always exits 0.
#
# Opt out entirely:  create /media/fat/linux/no_linux_modernization

CANON=/usr/share/mister-linux-modernization/update_linux_modernization.sh
LOGDIR=/media/fat/Scripts/.config/mister_linux_modernization
LOG="$LOGDIR/boot.log"

case "$1" in
	start)
		[ -x "$CANON" ] || exit 0
		[ -d /media/fat/linux ] || exit 0
		(
			mkdir -p "$LOGDIR" 2>/dev/null
			# Keep the log small; /media/fat is exFAT mounted sync.
			if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 65536 ]; then
				: > "$LOG"
			fi
			echo "--- $(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) boot" >> "$LOG" 2>/dev/null
			"$CANON" --boot-manage >> "$LOG" 2>&1
		) &
		;;
	stop|restart)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
