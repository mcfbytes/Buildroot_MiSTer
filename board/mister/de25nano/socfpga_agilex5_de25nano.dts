	gpio-keys {
		compatible = "gpio-keys";

		/* HPS_KEY on HPS GPIO40; polarity assumed like the LED beside it [U]. */
		key-0 {
			label = "hps_key0";
			gpios = <&portb 16 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
		};
	};
};

/* OCRAM is mister_ocram's and the handoff page's: keep both out of the mmio-sram pool. */
&ocram {
	mister-ocram@0 {
		reg = <0x0 0x7f000>;
	};

	handoff-sram@7f000 {
		reg = <0x7f000 0x1000>;
	};
};
