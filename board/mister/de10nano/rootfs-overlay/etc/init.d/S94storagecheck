#!/bin/sh
#
# S94storagecheck -- put Scripts/check_storage.sh on the card if it is missing.
#
# ADR 0026 ships the storage checker as two halves that must stay together: the
# tool (/usr/sbin/mister-fsck-exfat) and the repair itself (in the initramfs).
# Both ride inside linux.img, so any user who updates the Linux image already
# has the whole mechanism. What they do NOT get from an image update is an entry
# in the MiSTer Scripts menu, because that lives on the FAT data partition,
# which no image update writes to.
#
# Without this, the feature would be SSH-only for every existing user -- and the
# people most likely to be hit by exFAT damage are the least likely to have SSH
# set up. A freshly flashed sdcard.img gets the entry from the installer payload
# (scripts/fetch-sdcard-payload.sh); this covers everybody else.
#
# Deliberately conservative:
#
#   * CREATE ONLY. If check_storage.sh already exists -- ours, an older copy, or
#     something the user wrote -- it is left completely alone. This never
#     overwrites and never "upgrades" a file on the user's card. The shim is a
#     launcher for a tool that lives in the rootfs, so an old copy still works;
#     there is nothing to upgrade.
#   * NO DIRECTORY CREATION. If Scripts/ does not exist this does nothing rather
#     than inventing a layout on a card that may not be a MiSTer card at all.
#   * BEST EFFORT. A read-only or full card is not a boot failure; every path
#     here exits 0. The rest of the boot does not care.
#
# One write, once, on the first boot after an update -- not every boot.

SRC=/usr/share/mister-fsck-exfat/check_storage.sh
DEST=/media/fat/Scripts/check_storage.sh
# Derived, never written out a second time: a hardcoded directory here would be
# free to disagree with $DEST, and a guard that checks a different path than the
# code writes to is exactly how you get a silent no-op.
DEST_DIR=${DEST%/*}

start() {
	[ -f "$SRC" ] || exit 0
	[ -d "$DEST_DIR" ] || exit 0
	[ -e "$DEST" ] && exit 0

	# .part first, then rename: /media/fat is exFAT with no journal, and a power
	# cut mid-copy must not leave a truncated script in the Scripts menu that
	# runs and does something half-formed. The rename is the commit point.
	if cp "$SRC" "$DEST.part" 2>/dev/null &&
	   chmod 0755 "$DEST.part" 2>/dev/null &&
	   mv -f "$DEST.part" "$DEST" 2>/dev/null; then
		echo "Installed $DEST (storage check -- see Scripts menu)"
	else
		rm -f "$DEST.part" 2>/dev/null
	fi
	exit 0
}

case "$1" in
  start)
	start
	;;
  stop|restart|reload)
	# Nothing to undo: the file is the user's now. Removing it on shutdown would
	# fight the user's own card, and there is no service here to restart.
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
